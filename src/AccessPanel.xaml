<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <Border Background="White" BorderBrush="#DBE3EA" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="270"/></Grid.ColumnDefinitions>
   <StackPanel Margin="0,0,20,0"><TextBlock Text="Einrichten &amp; testen" FontSize="27" FontWeight="SemiBold"/><TextBlock x:Name="AccessHeadline" Text="Dienst wird geprüft …" FontSize="16" Margin="0,8,0,4" TextWrapping="Wrap"/><TextBlock x:Name="AccessExplanation" Text="Benötigte Verbindungen gezielt freigeben." Foreground="#57677B" TextWrapping="Wrap"/><TextBlock x:Name="AccessProof" FontSize="11" Foreground="#57677B" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
   <StackPanel Grid.Column="1"><Button x:Name="StartAccess" Content="Neue Programme zuerst fragen" Background="#087F8C" Foreground="White"/><Button x:Name="StopAccess" Content="Nachfragen ausschalten"/><Button x:Name="InstallControlService" Content="Hintergrunddienst installieren" Visibility="Collapsed"/><CheckBox x:Name="NotifyAttempts" Content="Neue Anfragen im Tray melden" IsChecked="True" Margin="0,10,0,4"/><CheckBox x:Name="NotifyTargets" Content="Auch neue Ziele bekannter Programme" ToolTip="Kann insbesondere bei Browsern viele Hinweise erzeugen."/></StackPanel>
  </Grid>
 </Border>
 <Border x:Name="RecoveryBanner" Grid.Row="1" Background="#FFF3D9" Padding="8" CornerRadius="8" Margin="0,0,0,12" Visibility="Collapsed"><DockPanel><Button x:Name="ConfirmSetup" DockPanel.Dock="Right" Content="Einrichtung bestätigen"/><TextBlock x:Name="RecoveryText" TextWrapping="Wrap"/></DockPanel></Border>
 <TabControl x:Name="AccessViews" Grid.Row="2" Background="#F4F7FA" BorderThickness="0">
  <TabItem Header="  Blockierte Versuche  "><Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="430"/></Grid.ColumnDefinitions>
   <Border Background="White" CornerRadius="10" Padding="16" Margin="0,0,14,0"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="Blockierte Versuche" FontSize="19" FontWeight="SemiBold"/><TextBlock x:Name="AccessEmpty" Text="Noch keine Versuche angezeigt." TextWrapping="Wrap" Foreground="#57677B" Margin="0,6,0,12"/></StackPanel><ListBox x:Name="AccessRequests"><ListBox.ItemTemplate><DataTemplate><StackPanel><DockPanel><TextBlock Text="{Binding Program}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding Count, StringFormat={}{0} Versuche}" HorizontalAlignment="Right" Foreground="#57677B"/></DockPanel><TextBlock Text="{Binding Target}" Margin="0,5,0,0"/><TextBlock Text="{Binding Direction}" FontSize="11" Foreground="#57677B"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border>
   <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="20"><DockPanel><StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0"><UniformGrid Columns="2"><Button x:Name="TrySetupRule" Content="5 Minuten testen" Background="#087F8C" Foreground="White" IsEnabled="False"/><Button x:Name="SaveSetupRule" Content="Regel speichern" IsEnabled="False"/></UniformGrid><Button x:Name="KeepAccessBlocked" Content="Gesperrt lassen" IsEnabled="False"/><TextBlock x:Name="AccessDecisionNotice" TextWrapping="Wrap" FontSize="11" Foreground="#57677B" Margin="0,8,0,0"/></StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Verbindung freigeben" FontSize="21" FontWeight="SemiBold"/><TextBlock x:Name="AccessProgramTitle" Text="Versuch auswählen" FontSize="18" Margin="0,14,0,4" TextWrapping="Wrap"/><TextBlock x:Name="AccessProgramState" Foreground="#A4680B" TextWrapping="Wrap"/><Expander Header="Programmpfad" Margin="0,5"><TextBox x:Name="AccessProgramPath" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"/></Expander><TextBlock x:Name="AccessTargetHint" TextWrapping="Wrap" Margin="0,0,0,14"/><TextBlock Text="Regelname"/><TextBox x:Name="SetupRuleName" MaxLength="100" Margin="0,6,0,12"/><TextBlock Text="Geltungsbereich"/><ComboBox x:Name="SetupRuleScope" SelectedIndex="0" Margin="0,6,0,8" Padding="8"><ComboBoxItem Content="Nur diese Verbindung (Programm, IP, Dienst)"/><ComboBoxItem Content="Dieses Programm · alle ausgehenden Ziele"/></ComboBox><CheckBox x:Name="SetupHostIcmp" Content="ICMP für diesen Rechner statt für eine EXE" Visibility="Collapsed" Margin="0,4,0,10"/><Border Background="#F0F5F8" CornerRadius="7" Padding="12"><TextBlock Text="Erst freigeben, dann die Funktion erneut versuchen. Port und IP beweisen keinen Zweck. Bei ICMP gilt die Regel für alle ICMP-Typen zum gewählten Ziel. Andere Firewall-Sperren bleiben wirksam." TextWrapping="Wrap" FontSize="12" Foreground="#57677B"/></Border></StackPanel></ScrollViewer>
   </DockPanel></Border>
  </Grid></TabItem>
  <TabItem Header="  Regeln &amp; Freigaben  "><DockPanel Margin="0,14,0,0"><StackPanel DockPanel.Dock="Top"><TextBlock Text="Deine benannten Regeln" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Gespeicherte Regeln werden vom Hintergrunddienst geladen. Eine Freigabe allein ist kein Nachweis erfolgreicher Übertragung." TextWrapping="Wrap" Foreground="#57677B" Margin="0,8"/><Button x:Name="RemoveSetupRule" Content="Ausgewählte Regel zurücknehmen" HorizontalAlignment="Left"/></StackPanel><DataGrid x:Name="SetupRules"><DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="230"/><DataGridTextColumn Header="Aktion" Binding="{Binding Action}" Width="80"/><DataGridTextColumn Header="Gilt für" Binding="{Binding Scope}" Width="*"/><DataGridTextColumn Header="Gültigkeit" Binding="{Binding Lifetime}" Width="150"/></DataGrid.Columns></DataGrid></DockPanel></TabItem>
  <TabItem Header="  Verlauf  "><DockPanel Margin="0,14,0,0"><TextBlock DockPanel.Dock="Top" Text="Regeländerungen seit dem letzten Dienststart · maximal 100 Einträge" Margin="0,0,0,12" Foreground="#57677B"/><ListBox x:Name="SetupHistory"/></DockPanel></TabItem>
 </TabControl>
</Grid>
