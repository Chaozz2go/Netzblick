<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Margin="0,0,0,14"><TextBlock Text="Sichern &amp; wiederherstellen" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Eigene Netzblick-Einstellungen lokal sichern und gezielt zurückholen." Foreground="{DynamicResource Muted}" Margin="0,6,0,0"/></StackPanel><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel><Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" Padding="20"><StackPanel><TextBlock Text="Eine Sicherung für deine Einstellungen" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Enthält bestätigte eigene Dienstregeln, Favoriten, Programmgruppen und Prüfentscheidungen. Bei nicht erreichbarem Filterdienst werden nur die Benutzerdaten gesichert. Zeitstrahl, Datei-Vergleichsstände, Design und ältere Windows-Regeln sind nicht Teil dieses Exports." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,10"/><Button x:Name="BackupSave" Content="Sicherung speichern …" HorizontalAlignment="Left" Background="{DynamicResource AccentSoft}"/></StackPanel></Border><Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" Padding="20" Margin="0,14,0,0"><StackPanel><TextBlock Text="Nur die gewählte Kategorie zurückholen" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Vor jeder Übernahme siehst du die Auswirkungen. Der bisherige Zustand wird zusätzlich im lokalen Datenordner gesichert. Andere Kategorien und fremde Firewallregeln bleiben erhalten." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,10"/><Button x:Name="BackupLoad" Content="Sicherung auswählen …" HorizontalAlignment="Left"/><TextBlock x:Name="BackupSummary" TextWrapping="Wrap" Margin="0,12"/><ComboBox x:Name="BackupCategory" SelectedIndex="0" MaxWidth="420" HorizontalAlignment="Left"><ComboBoxItem Content="Eigene Dienstregeln &amp; Programm-Prüfsperren"/><ComboBoxItem Content="Favoriten"/><ComboBoxItem Content="Programmgruppen"/><ComboBoxItem Content="Prüfentscheidungen"/></ComboBox><Button x:Name="BackupPreview" Content="Auswirkungen ansehen …" HorizontalAlignment="Left" Background="{DynamicResource AccentSoft}" Margin="0,12,0,0"/></StackPanel></Border><TextBlock x:Name="BackupNotice" TextWrapping="Wrap" Foreground="{DynamicResource Accent}" Margin="0,14"/><TextBlock Text="Sicherungen können lokale Programmpfade und beobachtete Netzwerkziele enthalten. Die Datei wird nicht hochgeladen. Beim Wiederherstellen werden keine Programme gestartet und keine allgemeinen Windows-Firewall-Einstellungen verändert." Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap"/></StackPanel></ScrollViewer></Grid>
