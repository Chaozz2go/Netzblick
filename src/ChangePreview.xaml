<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=mscorlib" Title="Auswirkung vor dem Ändern" Width="850" Height="690" MinWidth="650" MinHeight="550" WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBg}" Foreground="{DynamicResource Text}" FontFamily="Segoe UI">
 <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel><TextBlock Text="Was würde diese Änderung treffen?" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/><ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="140" Margin="0,10,0,6"><TextBlock x:Name="PreviewScope" TextWrapping="Wrap"/></ScrollViewer><TextBlock x:Name="PreviewFootprint" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"/><ComboBox x:Name="PreviewDuration" Margin="0,10,0,0" SelectedIndex="0" Visibility="Collapsed"><ComboBoxItem Content="10 Minuten sperren" Tag="10"/><ComboBoxItem Content="30 Minuten sperren" Tag="30"/><ComboBoxItem Content="1 Stunde sperren" Tag="60"/><ComboBoxItem Content="Sperren, bis ich sie aufhebe" Tag="0"/></ComboBox><TextBlock x:Name="PreviewWarning" Foreground="{DynamicResource Warning}" TextWrapping="Wrap" Margin="0,12"/><TextBlock x:Name="PreviewHint" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,10"/></StackPanel>
 <DataGrid x:Name="PreviewMatches" Grid.Row="1" SelectionMode="Single" RowHeight="{x:Static sys:Double.NaN}" MinRowHeight="58"><DataGrid.Columns><DataGridTextColumn Header="Programm" Binding="{Binding Program}" Width="120"/><DataGridTextColumn Header="Richtung" Binding="{Binding Direction}" Width="90"/><DataGridTextColumn Header="Ziel / Dienstport" Binding="{Binding Target}" Width="180"/><DataGridTextColumn Header="Beobachtung" Binding="{Binding Source}" Width="155"/><DataGridTemplateColumn Header="Danach laut Netzblick-Regeln" Width="*" MinWidth="210"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding After}" TextWrapping="Wrap" ToolTip="{Binding Before}" Margin="6"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid>
 <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,14,0,0"><Button Content="Abbrechen" IsCancel="True"/><Button x:Name="ApplyPreview" Content="Anwenden" IsDefault="True" Background="{DynamicResource AccentSoft}"/></WrapPanel>
 </Grid>
</Window>
