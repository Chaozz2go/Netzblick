<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid.RowDefinitions><RowDefinition Height="78"/><RowDefinition Height="*"/><RowDefinition Height="172"/></Grid.RowDefinitions>
 <UniformGrid Columns="3" Margin="0,0,0,10">
  <Button x:Name="DashboardActive" HorizontalContentAlignment="Left" ToolTip="Gerade aktive Programme öffnen"><StackPanel><TextBlock x:Name="DashboardActiveCount" Text="0" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="aktiv · Socket oder Aktivität ≤ 30 s" FontSize="11" Foreground="{DynamicResource Muted}"/></StackPanel></Button>
  <Button x:Name="DashboardBlocked" ToolTip="Programm mit zuletzt erfasstem Blockversuch ansehen"><StackPanel><TextBlock x:Name="DashboardBlockedCount" Text="0" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource Danger}"/><TextBlock Text="Blockversuche · seit Dienststart" FontSize="11" Foreground="{DynamicResource Muted}"/></StackPanel></Button>
  <Button x:Name="DashboardReview" ToolTip="Gemeinsame Prüfliste öffnen"><StackPanel><TextBlock x:Name="DashboardReviewCount" Text="0" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource Warning}"/><TextBlock Text="Programme zu prüfen" FontSize="11" Foreground="{DynamicResource Muted}"/></StackPanel></Button>
 </UniformGrid>
 <Grid Grid.Row="1" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
  <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="{DynamicResource CardCorner}" Margin="0,0,12,0" Padding="12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel><WrapPanel DockPanel.Dock="Right"><Button x:Name="DashboardFreeze" Content="Ⅱ Einfrieren" Padding="8,4" ToolTip="Nur das Dashboard einfrieren; Erfassung und Filter laufen weiter"/><ComboBox x:Name="DashboardPeriod" SelectedIndex="0" Width="110"><ComboBoxItem Content="60 Sekunden" Tag="60"/><ComboBoxItem Content="3 Minuten" Tag="180"/><ComboBoxItem Content="5 Minuten" Tag="300"/></ComboBox></WrapPanel><TextBlock Text="Netzwerk live" FontSize="18" FontWeight="SemiBold"/></DockPanel>
   <Viewbox Grid.Row="1" Stretch="Uniform"><Canvas x:Name="DashboardNetwork" Width="960" Height="520" ClipToBounds="True"/></Viewbox>
   <StackPanel Grid.Row="2"><WrapPanel Margin="0,6,0,4"><TextBlock Text="→ Ausgehend   " Foreground="{DynamicResource Accent}"/><TextBlock Text="← Eingehend   " Foreground="{DynamicResource Inbound}"/><TextBlock Text="⊘ Blockiert   " Foreground="{DynamicResource Danger}"/><TextBlock Text="— Unbekannt" Foreground="{DynamicResource Muted}"/></WrapPanel><TextBlock x:Name="DashboardGraphHint" Text="Richtung = Verbindungsaufbau · Ziele zusammengefasst · Programm anklicken" Foreground="{DynamicResource Muted}" FontSize="10" TextWrapping="Wrap"/></StackPanel>
  </Grid></Border>
  <Border Grid.Column="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="{DynamicResource CardCorner}" Padding="14"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
   <DockPanel Margin="0,0,0,8"><Image x:Name="DashboardProgramIcon" Width="38" Height="38" Margin="0,0,10,0" DockPanel.Dock="Left"/><StackPanel><TextBlock x:Name="DashboardProgramName" Text="Programm auswählen" FontSize="21" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="DashboardProgramStatus" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="11"/></StackPanel></DockPanel>
   <TextBlock Text="VERBINDUNGSAUFBAU" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,12,0,6"/>
   <TextBlock x:Name="DashboardDirections" Text="Noch keine Erfassung." TextWrapping="Wrap" FontSize="14"/>
   <TextBlock x:Name="DashboardTargets" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
   <Separator Margin="0,14"/><TextBlock Text="DATENRICHTUNG · PROGRAMM" Foreground="{DynamicResource Muted}" FontSize="10"/>
   <TextBlock x:Name="DashboardProgramRx" Text="↓ Empfang —" Foreground="{DynamicResource Accent}" FontSize="18" Margin="0,8,0,4"/><TextBlock x:Name="DashboardProgramTx" Text="↑ Versand —" Foreground="{DynamicResource Blue}" FontSize="18"/>
   <TextBlock x:Name="DashboardProgramReview" Foreground="{DynamicResource Warning}" TextWrapping="Wrap" Margin="0,12"/>
   <Button x:Name="DashboardDetails" Content="Programmdetails →" HorizontalAlignment="Left" Background="{DynamicResource AccentSoft}"/>
   <Button x:Name="DashboardTemporaryBlock" Content="Zeitweise sperren …" HorizontalAlignment="Left" Background="{DynamicResource WarningSoft}"/>
   <TextBlock Text="Ausgehende Verbindungen können Daten empfangen und senden. Empfang ist kein eingehender Verbindungsaufbau." Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0"/>
  </StackPanel></ScrollViewer></Border>
 </Grid>
 <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="{DynamicResource CardCorner}" Padding="12" Margin="0,0,12,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><TextBlock Text="↓ Empfang" FontSize="17" Foreground="{DynamicResource Accent}"/><TextBlock x:Name="DashboardRx" Text="Messung …" FontSize="21" FontWeight="SemiBold" HorizontalAlignment="Right"/></DockPanel><Canvas x:Name="DashboardRxGraph" Grid.Row="1" ClipToBounds="True" MinHeight="70"/><TextBlock x:Name="DashboardRxHint" Grid.Row="2" Text="Adapter gesamt · noch keine Messpunkte" FontSize="10" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/></Grid></Border>
  <Border Grid.Column="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="{DynamicResource CardCorner}" Padding="12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><TextBlock Text="↑ Versand" FontSize="17" Foreground="{DynamicResource Blue}"/><TextBlock x:Name="DashboardTx" Text="Messung …" FontSize="21" FontWeight="SemiBold" HorizontalAlignment="Right"/></DockPanel><Canvas x:Name="DashboardTxGraph" Grid.Row="1" ClipToBounds="True" MinHeight="70"/><TextBlock x:Name="DashboardTxHint" Grid.Row="2" Text="Adapter gesamt · virtuelle Adapter können doppelt zählen" FontSize="10" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/></Grid></Border>
 </Grid>
</Grid>
