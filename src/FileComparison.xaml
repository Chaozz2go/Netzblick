<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=mscorlib" Title="Dateiänderung ansehen" Width="880" Height="620" MinWidth="700" MinHeight="500" WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBg}" Foreground="{DynamicResource Text}" FontFamily="Segoe UI"><Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Was hat sich an der Datei geändert?" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="FilePath" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,8"/><TextBlock Text="Ein Update kann diese Änderung erklären. Dateiversion, Herstellerangabe und eingebetteter Unterzeichner beweisen keine Unbedenklichkeit. Vertrauen und Katalogsignaturen werden nicht geprüft. Netzwerkziele und Firewallregeln bleiben unabhängig davon." TextWrapping="Wrap" Foreground="{DynamicResource Warning}" Margin="0,0,0,14"/></StackPanel><DataGrid x:Name="FileDifferences" Grid.Row="1" RowHeight="{x:Static sys:Double.NaN}" MinRowHeight="55"><DataGrid.Columns><DataGridTextColumn Header="Angabe" Binding="{Binding Field}" Width="140"/><DataGridTemplateColumn Header="Gespeicherte Vergleichsbasis" Width="*" MinWidth="250"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Before}" TextWrapping="Wrap" Margin="6"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header="Zuletzt vollständig gelesen" Width="*" MinWidth="250"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding After}" TextWrapping="Wrap" Margin="6"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid><StackPanel Grid.Row="2" Margin="0,12,0,0"><TextBlock Text="Beim Übernehmen wird der Inhalt erneut gelesen. Nur bei identischem Ergebnis wird die neue Vergleichsbasis gespeichert; es wird keine Firewallfreigabe erteilt." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="11"/><WrapPanel HorizontalAlignment="Right" Margin="0,8,0,0"><Button Content="Schließen" IsCancel="True"/><Button x:Name="AcceptFile" Content="Neue Vergleichsbasis übernehmen" Background="{DynamicResource AccentSoft}"/></WrapPanel></StackPanel></Grid></Window>
