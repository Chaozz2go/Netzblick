<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Programmgruppe bestätigen" Width="850" Height="660" MinWidth="700" MinHeight="550" WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBg}" Foreground="{DynamicResource Text}" FontFamily="Segoe UI"><Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Welche EXEs gehören zu dieser Gruppe?" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Nur selbst ausgewählte Pfade werden gespeichert. Ähnliche Namen oder Ordner beweisen keine Zugehörigkeit. Maximal 16 EXEs pro Gruppe; geschützte Windows-Sammelprozesse können gemeinsam angesehen, aber nicht pauschal gesperrt werden." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,8,0,12"/><TextBox x:Name="GroupName" MaxLength="80" ToolTip="Gruppenname"/><Button x:Name="GroupBrowse" Content="Weitere EXE-Dateien auswählen …" HorizontalAlignment="Left" Margin="0,8"/></StackPanel><DataGrid x:Name="GroupCandidates" Grid.Row="1" IsReadOnly="False" SelectionMode="Single"><DataGrid.Columns><DataGridCheckBoxColumn Header="Dabei" Binding="{Binding Include, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="60"/><DataGridTextColumn Header="Programm" Binding="{Binding Name}" Width="150" IsReadOnly="True"/><DataGridTextColumn Header="Vollständiger Pfad" Binding="{Binding Path}" Width="*" MinWidth="300" IsReadOnly="True"/></DataGrid.Columns></DataGrid><StackPanel Grid.Row="2" Margin="0,10,0,0"><TextBlock x:Name="GroupEditorNotice" TextWrapping="Wrap" Foreground="{DynamicResource Warning}"/><WrapPanel HorizontalAlignment="Right"><Button Content="Abbrechen" IsCancel="True"/><Button x:Name="GroupSave" Content="Diese Mitglieder bestätigen" Background="{DynamicResource AccentSoft}"/></WrapPanel></StackPanel></Grid></Window>
