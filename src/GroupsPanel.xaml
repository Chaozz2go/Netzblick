<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,12"><Button x:Name="GroupNew" Content="Gruppe anlegen …" DockPanel.Dock="Right"/><StackPanel><TextBlock Text="Programmgruppen" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Zugehörige EXEs gemeinsam ansehen und den Umfang jeder Sperre bewusst wählen." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></DockPanel>
 <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ListBox x:Name="GroupsList" Margin="0,0,12,0"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="{Binding Paths.Count, StringFormat={}{0} bestätigte EXE-Pfade}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,5,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
 <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock x:Name="GroupTitle" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="GroupScope" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,6,0,8"/><WrapPanel><Button x:Name="GroupEdit" Content="Mitglieder bearbeiten …"/><Button x:Name="GroupRemove" Content="Gruppe entfernen"/></WrapPanel></StackPanel><DataGrid x:Name="GroupMembers" Grid.Row="1" SelectionMode="Single" Margin="0,8" RowHeight="65"><DataGrid.Columns><DataGridTemplateColumn Header="Bestätigtes Mitglied" Width="*" MinWidth="210"><DataGridTemplateColumn.CellTemplate><DataTemplate><DockPanel Margin="4"><Ellipse Width="10" Height="10" Fill="{Binding Color}" DockPanel.Dock="Left" Margin="0,0,8,0"/><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Status}" Foreground="{DynamicResource Muted}"/><TextBlock Text="{Binding Activity}" FontSize="10" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"/></StackPanel></DockPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Zeitweise Entscheidung" Binding="{Binding Lease}" Width="240"/></DataGrid.Columns></DataGrid><StackPanel Grid.Row="2"><TextBlock x:Name="GroupMemberPath" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"/><WrapPanel Margin="0,8,0,0"><Button x:Name="GroupMemberDetails" Content="Nur Auswahl ansehen →"/><Button x:Name="GroupMemberBlock" Content="Nur diese EXE zeitweise sperren …" Background="{DynamicResource WarningSoft}"/></WrapPanel><Separator Margin="0,8"/><WrapPanel><Button x:Name="GroupPause" Content="Ganze Gruppe zeitweise sperren …" Background="{DynamicResource DangerSoft}"/><Button x:Name="GroupResume" Content="Zeitweise Entscheidungen der Gruppe beenden …"/></WrapPanel><TextBlock x:Name="GroupNotice" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,8,0,0"/></StackPanel></Grid></Grid>
</Grid>
