<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <StackPanel Margin="0,0,0,10"><TextBlock Text="Hostprozesse &amp; Dienste" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Welche Windows-Dienste teilen sich einen Prozess? Verbindungen werden dem Prozess zugeordnet, nicht einzelnen Diensten." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
 <DockPanel Grid.Row="1" Margin="0,0,0,10"><Button x:Name="HostsRefresh" DockPanel.Dock="Right" Content="Dienste aktualisieren"/><ComboBox x:Name="HostsFilter" DockPanel.Dock="Right" SelectedIndex="0" Width="180"><ComboBoxItem Content="Alle Hostprozesse"/><ComboBoxItem Content="Netzwerk sichtbar"/><ComboBoxItem Content="Gesperrt / eingeschränkt"/><ComboBoxItem Content="Zu prüfen (Dateipfad)"/></ComboBox><TextBox x:Name="HostsSearch" MinWidth="180" ToolTip="Prozess, PID, Dienstname oder Beschreibung suchen"/></DockPanel>
 <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="38*" MinWidth="300"/><ColumnDefinition Width="12"/><ColumnDefinition Width="62*"/></Grid.ColumnDefinitions>
  <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" Padding="10"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock x:Name="HostsSummary" Text="Dienste werden beim Öffnen ermittelt …" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,8"/>
   <DataGrid x:Name="HostsList" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False" HeadersVisibility="Column" RowHeight="86"><DataGrid.Columns><DataGridTemplateColumn Header="Prozess / zugehörige Dienste" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Margin="4,5"><DockPanel><Ellipse Width="10" Height="10" Fill="{Binding SignalColor}" Margin="0,0,7,0" DockPanel.Dock="Left"/><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></DockPanel><TextBlock Text="{Binding ServiceNames}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ServiceNames}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="17,4,0,0"/><TextBlock Text="{Binding Summary}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="17,3,0,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid>
  </Grid></Border>
  <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" Padding="12" Margin="0,0,0,10"><StackPanel><TextBlock x:Name="HostTitle" Text="Hostprozess auswählen" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="HostPath" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0"/><TextBlock x:Name="HostScope" TextWrapping="Wrap" Foreground="{DynamicResource Warning}" Margin="0,7,0,0"/><WrapPanel Margin="0,8,0,0"><Button x:Name="HostProgramDetails" Content="Gemeinsame Programmdetails →" IsEnabled="False"/><Button x:Name="HostRules" Content="Regeln für den Dateipfad →" IsEnabled="False"/></WrapPanel></StackPanel></Border>
   <TabControl Grid.Row="1"><TabItem Header="Dienste"><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="HostServices"><ItemsControl.ItemTemplate><DataTemplate><Expander Margin="0,6" IsExpanded="{Binding Expanded, Mode=TwoWay}"><Expander.Header><StackPanel><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Foreground="{DynamicResource Muted}"><Run Text="{Binding Name}"/><Run Text=" · "/><Run Text="{Binding State}"/></TextBlock></StackPanel></Expander.Header><TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="18,8,8,10"/></Expander></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></TabItem>
   <TabItem Header="Verbindungen"><Grid Margin="0,8,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Nur Sockets dieser PID und Startzeit. Richtung = Verbindungsaufbau; kein Nachweis für einen einzelnen Dienst." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,8"/><DataGrid x:Name="HostConnections" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Richtung" Binding="{Binding Direction}" Width="105"/><DataGridTextColumn Header="Protokoll" Binding="{Binding Protocol}" Width="75"/><DataGridTextColumn Header="Lokal" Binding="{Binding Local}" Width="160"/><DataGridTextColumn Header="Gegenstelle" Binding="{Binding Remote}" Width="180"/><DataGridTextColumn Header="Status" Binding="{Binding State}" Width="110"/></DataGrid.Columns></DataGrid></Grid></TabItem>
   <TabItem Header="Sperrgründe (Dateipfad)"><Grid Margin="0,8,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock x:Name="HostBlockHint" TextWrapping="Wrap" Foreground="{DynamicResource Warning}" Margin="0,0,0,8"/><DataGrid x:Name="HostBlocks" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Richtung" Binding="{Binding Direction}" Width="95"/><DataGridTextColumn Header="Gegenstelle" Binding="{Binding Remote}" Width="160"/><DataGridTextColumn Header="Versuche" Binding="{Binding Count}" Width="70"/><DataGridTemplateColumn Header="Erfasster Grund" Width="*" MinWidth="200"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding BlockReason}" ToolTip="{Binding BlockReason}" TextTrimming="CharacterEllipsis" Margin="3,0"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></Grid></TabItem></TabControl>
  </Grid>
 </Grid>
</Grid>
