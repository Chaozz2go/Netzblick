<ScrollViewer xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
 <Grid MinHeight="600">
 <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="65"/><RowDefinition Height="45"/><RowDefinition Height="330"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel>
  <WrapPanel><Button x:Name="ChooseInspection" Content="1 · EXE auswählen"/><Button x:Name="StartInspection" Content="2 · Sperren und prüfen" Background="#16564F" IsEnabled="False"/><Button x:Name="StopInspection" Content="Prüfung beenden" IsEnabled="False"/><Button x:Name="SaveInspectionReport" Content="Bericht speichern" IsEnabled="False"/></WrapPanel>
  <TextBox x:Name="InspectionPath" IsReadOnly="True" Margin="0,3,0,6" ToolTip="Netzblick startet keine EXE mit Administratorrechten." Text="Wähle das Programm, das du vor dem eigenen Start sperren und beobachten möchtest."/>
 </StackPanel>
 <Border Grid.Row="1" Background="#192C42" BorderBrush="#35516B" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,6">
  <StackPanel>
   <TextBlock x:Name="InspectionPhase" Text="Bereit für deine Auswahl" FontSize="20" FontWeight="SemiBold" Foreground="#4EA5FF"/>
   <TextBlock x:Name="InspectionNext" Text="Nach dem Sperren startest du das Programm selbst. Netzblick zeigt dir, ob ein Prozess und ein sichtbares Fenster erkannt werden." TextWrapping="Wrap" Margin="0,5,0,5" Foreground="#B6CDE3"/>
   <ProgressBar x:Name="InspectionPulse" Height="3" IsIndeterminate="False" Value="0" Maximum="1" Foreground="#39DCC0" Background="#20364E"/>
   <TextBlock x:Name="InspectionHeartbeat" Text="Noch keine Prüfung aktiv" FontSize="11" Foreground="#91ADC8" Margin="0,4,0,0"/>
  </StackPanel>
 </Border>
 <Expander Grid.Row="2" Header="Dateiinformationen und Prüfschritte" Foreground="#A8C1D9" Margin="0,0,0,6">
  <StackPanel>
   <TextBlock x:Name="InspectionMetadata" Text="Dateiinformationen erscheinen nach der Auswahl." FontSize="11" TextWrapping="Wrap" Margin="8"/>
   <ListBox x:Name="InspectionActivity" Height="100" ScrollViewer.VerticalScrollBarVisibility="Auto"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="11"/></DataTemplate></ListBox.ItemTemplate></ListBox>
  </StackPanel>
 </Expander>
 <UniformGrid Grid.Row="3" Columns="4">
  <Border Background="#2F1D2C" CornerRadius="6" Padding="8" Margin="0,0,8,0"><StackPanel><TextBlock Text="Blockiert · ausgehend" Foreground="#CC9BA6" FontSize="11"/><TextBlock x:Name="InspectionOutgoing" Text="0" FontSize="22" Foreground="#FF7E85"/></StackPanel></Border>
  <Border Background="#142235" CornerRadius="6" Padding="8" Margin="0,0,8,0"><StackPanel><TextBlock Text="Blockiert · eingehend" Foreground="#91ADC8" FontSize="11"/><TextBlock x:Name="InspectionIncoming" Text="0" FontSize="22"/></StackPanel></Border>
  <Border Background="#142235" CornerRadius="6" Padding="8" Margin="0,0,8,0"><StackPanel><TextBlock Text="Prozesse · aktiv / gesehen" Foreground="#91ADC8" FontSize="11"/><TextBlock x:Name="InspectionProcessCount" Text="0 / 0" FontSize="22"/></StackPanel></Border>
  <Border Background="#142235" CornerRadius="6" Padding="8"><StackPanel><TextBlock Text="Übertragene Nutzdaten" Foreground="#91ADC8" FontSize="11"/><TextBlock Text="Nicht gemessen" FontSize="18" Foreground="#F5C477"/></StackPanel></Border>
 </UniformGrid>
 <DockPanel Grid.Row="4" Margin="0,3"><TextBlock DockPanel.Dock="Left" Text="Blockierte Versuche" Width="120" FontSize="11" Foreground="#91ADC8"/><Viewbox Stretch="Fill"><Canvas x:Name="InspectionTimeline" Width="1000" Height="48"/></Viewbox></DockPanel>
 <Grid Grid.Row="5"><Grid.ColumnDefinitions><ColumnDefinition Width="245"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#142235" CornerRadius="7" Padding="8" Margin="0,0,10,0"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="PROGRAMM UND HILFSPROZESSE" Foreground="#91ADC8" FontSize="11"/><TextBlock Text="Hilfsprozesse sind zunächst nur beobachtet." TextWrapping="Wrap" FontSize="11" Foreground="#F5C477" Margin="0,4"/><Button x:Name="BlockInspectionChild" Content="Gewählten Prozesspfad sperren" IsEnabled="False" FontSize="11" Padding="4,8"/></StackPanel><ListBox x:Name="InspectionProcesses"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Caption}" TextWrapping="Wrap" FontSize="12"/><TextBlock Text="{Binding State}" Foreground="#39DCC0" FontSize="11" TextWrapping="Wrap"/><TextBlock Text="{Binding WindowState}" Foreground="#91ADC8" FontSize="11" TextWrapping="Wrap"/><TextBlock Text="{Binding Guard}" Foreground="#F5C477" FontSize="11" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border>
  <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="100"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#142235" CornerRadius="7" Padding="4" Margin="0,0,6,0"><Viewbox Stretch="Uniform"><Canvas x:Name="InspectionGraph" Width="600" Height="210"/></Viewbox></Border><Border Grid.Column="1" Background="#0A1B2C" CornerRadius="7" Padding="3"><Viewbox Stretch="Uniform"><Canvas x:Name="InspectionWorld" Width="1000" Height="500" ClipToBounds="True"><Canvas x:Name="InspectionOverlay" Width="1000" Height="500"/></Canvas></Viewbox></Border></Grid>
   <DockPanel Grid.Row="1">
    <TextBlock DockPanel.Dock="Top" Text="VERBINDUNGSVERSUCHE · blockiert, keine bestätigte Übertragung" Foreground="#CC9BA6" FontSize="11" Margin="0,2,0,5"/>
    <TextBlock DockPanel.Dock="Bottom" Text="Diensthinweise beruhen auf Ports. DNS-Namen belegen weder Betreiber noch den genauen Zweck." Foreground="#91ADC8" TextWrapping="Wrap" FontSize="11" Margin="0,5,0,0"/>
    <DataGrid x:Name="InspectionEvents" SelectionMode="Single"><DataGrid.Columns><DataGridTextColumn Header="Zeit" Binding="{Binding Time}" Width="80"/><DataGridTextColumn Header="Programm / PID" Binding="{Binding Subject}" Width="135"/><DataGridTextColumn Header="Richtung" Binding="{Binding Direction}" Width="85"/><DataGridTextColumn Header="IP / Port" Binding="{Binding Endpoint}" Width="220"/><DataGridTextColumn Header="Name / Bereich" Binding="{Binding PeerName}" Width="200"/><DataGridTextColumn Header="Diensthinweis" Binding="{Binding ServiceHint}" Width="220"/><DataGridTextColumn Header="Land" Binding="{Binding Country}" Width="110"/></DataGrid.Columns></DataGrid>
   </DockPanel>
  </Grid>
 </Grid>
 <TextBlock Grid.Row="6" x:Name="InspectionStatus" Text="Beim Prüfstart wird Windows-Audit vorübergehend systemweit aktiviert. Die Programmsperre bleibt nach Prüfende aktiv und kann unter Programme aufgehoben werden. Eine leere Liste ist kein Sicherheitsnachweis." Foreground="#F5C477" FontSize="11" Margin="0,7,0,0" TextWrapping="Wrap"/>
 </Grid>
</ScrollViewer>
