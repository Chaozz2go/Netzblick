<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid.RowDefinitions><RowDefinition Height="45"/><RowDefinition Height="76"/><RowDefinition Height="60"/><RowDefinition Height="65"/><RowDefinition Height="*"/><RowDefinition Height="46"/></Grid.RowDefinitions>
 <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="ChooseInspection" Content="EXE auswählen"/><Button x:Name="StartInspection" Content="Sperren und prüfen" Background="#16564F" IsEnabled="False"/><Button x:Name="StopInspection" Content="Prüfung beenden" IsEnabled="False"/><Button x:Name="SaveInspectionReport" Content="Bericht" IsEnabled="False"/></StackPanel><TextBox x:Name="InspectionPath" IsReadOnly="True" VerticalContentAlignment="Center" Margin="0,3,10,3" ToolTip="Ausgewählte Datei · Netzblick führt sie nicht aus" Text="1. EXE auswählen → 2. sperren und prüfen → 3. selbst mit normalen Rechten starten"/></DockPanel>
 <Border Grid.Row="1" Background="#142235" CornerRadius="6" Padding="10" Margin="0,6"><ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock x:Name="InspectionMetadata" Text="Dateiinformationen und SHA-256 erscheinen nach der Auswahl. Das Programm wird von Netzblick nicht gestartet." Foreground="#A8C1D9" FontSize="12" TextWrapping="Wrap"/></ScrollViewer></Border>
 <UniformGrid Grid.Row="2" Columns="4"><Border Background="#2F1D2C" CornerRadius="6" Padding="10" Margin="0,0,10,0"><StackPanel><TextBlock Text="Blockiert · ausgehend" Foreground="#CC9BA6" FontSize="11"/><TextBlock x:Name="InspectionOutgoing" Text="0" FontSize="22" Foreground="#FF7E85"/></StackPanel></Border><Border Background="#142235" CornerRadius="6" Padding="10" Margin="0,0,10,0"><StackPanel><TextBlock Text="Blockiert · eingehend" Foreground="#91ADC8" FontSize="11"/><TextBlock x:Name="InspectionIncoming" Text="0" FontSize="22"/></StackPanel></Border><Border Background="#142235" CornerRadius="6" Padding="10" Margin="0,0,10,0"><StackPanel><TextBlock Text="Beobachtete Prozesse" Foreground="#91ADC8" FontSize="11"/><TextBlock x:Name="InspectionProcessCount" Text="0" FontSize="22"/></StackPanel></Border><Border Background="#142235" CornerRadius="6" Padding="10"><StackPanel><TextBlock Text="Gesendete / empfangene Bytes" Foreground="#91ADC8" FontSize="11"/><TextBlock Text="Nicht gemessen" FontSize="18" Foreground="#F5C477"/></StackPanel></Border></UniformGrid>
 <DockPanel Grid.Row="3" Margin="0,6"><TextBlock DockPanel.Dock="Left" Text="Versuche&#10;pro Sekunde" Width="85" FontSize="11" Foreground="#91ADC8"/><Viewbox Stretch="Fill"><Canvas x:Name="InspectionTimeline" Width="1000" Height="48"/></Viewbox></DockPanel>
 <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#142235" CornerRadius="7" Padding="10" Margin="0,0,12,0"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="PROGRAMM UND HILFSPROZESSE" Foreground="#91ADC8" FontSize="11"/><Button x:Name="BlockInspectionChild" Content="Gewählten Prozesspfad sperren" IsEnabled="False" FontSize="11" Padding="5,8"/></StackPanel><ListBox x:Name="InspectionProcesses"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Caption}" TextWrapping="Wrap" FontSize="12"/><TextBlock Text="{Binding Guard}" Foreground="#F5C477" FontSize="11" TextWrapping="Wrap"/><TextBlock Text="{Binding State}" Foreground="#91ADC8" FontSize="11"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border>
  <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="160"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#142235" CornerRadius="7" Padding="7" Margin="0,0,10,0"><Viewbox Stretch="Uniform"><Canvas x:Name="InspectionGraph" Width="600" Height="210"/></Viewbox></Border><Border Grid.Column="1" Background="#0A1B2C" CornerRadius="7" Padding="4"><Viewbox Stretch="Uniform"><Canvas x:Name="InspectionWorld" Width="1000" Height="500" ClipToBounds="True"><Canvas x:Name="InspectionOverlay" Width="1000" Height="500"/></Canvas></Viewbox></Border></Grid>
   <DataGrid Grid.Row="1" x:Name="InspectionEvents" SelectionMode="Single"><DataGrid.Columns><DataGridTextColumn Header="Zeit" Binding="{Binding Time}" Width="100"/><DataGridTextColumn Header="Programm / PID" Binding="{Binding Subject}" Width="160"/><DataGridTextColumn Header="Richtung" Binding="{Binding Direction}" Width="90"/><DataGridTextColumn Header="Typ" Binding="{Binding Protocol}" Width="65"/><DataGridTextColumn Header="Quelle → Ziel" Binding="{Binding Endpoint}" Width="*"/><DataGridTextColumn Header="Land" Binding="{Binding Country}" Width="120"/></DataGrid.Columns></DataGrid>
  </Grid>
 </Grid>
 <TextBlock Grid.Row="5" x:Name="InspectionStatus" Text="Vor dem Start: Windows-Audit wird für die Sitzung systemweit aktiviert. Die Ansicht filtert auf das gewählte Programm und zugeordnete Hilfsprozesse. Sperren bleiben nach Sitzungsende aktiv." Foreground="#F5C477" FontSize="11" TextWrapping="Wrap"/>
</Grid>
