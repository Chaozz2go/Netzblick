<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Netzblick · 0.13.0" Width="1480" Height="920" MinWidth="1280" MinHeight="800" Background="{DynamicResource AppBg}" Foreground="{DynamicResource Text}" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <SolidColorBrush x:Key="AppBg" Color="#F4F7FA"/>
  <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Sidebar" Color="#EEF2F6"/>
  <SolidColorBrush x:Key="Raised" Color="#EDF2F6"/>
  <SolidColorBrush x:Key="Alternate" Color="#F0F5F8"/>
  <SolidColorBrush x:Key="Input" Color="#F5F8FA"/>
  <SolidColorBrush x:Key="Text" Color="#19283C"/>
  <SolidColorBrush x:Key="Muted" Color="#57677B"/>
  <SolidColorBrush x:Key="Border" Color="#D5E0E8"/>
  <SolidColorBrush x:Key="Accent" Color="#087F8C"/>
  <SolidColorBrush x:Key="AccentSoft" Color="#DDF0F2"/>
  <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Blue" Color="#1672B6"/>
  <SolidColorBrush x:Key="Danger" Color="#B32D40"/>
  <SolidColorBrush x:Key="DangerSoft" Color="#F9E5E7"/>
  <SolidColorBrush x:Key="Warning" Color="#996000"/>
  <SolidColorBrush x:Key="WarningSoft" Color="#FFF3D9"/>
  <SolidColorBrush x:Key="Success" Color="#08704E"/>
  <SolidColorBrush x:Key="SuccessSoft" Color="#E0F2EB"/>
  <SolidColorBrush x:Key="MapBg" Color="#0A1B2C"/>
  <SolidColorBrush x:Key="MapBorder" Color="#27405B"/>
  <SolidColorBrush x:Key="ConsoleBg" Color="#08111C"/>
  <SolidColorBrush x:Key="ConsoleText" Color="#69DAC3"/>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style TargetType="Button"><Setter Property="Background" Value="{DynamicResource Raised}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/><Setter Property="Padding" Value="14,6"/><Setter Property="Margin" Value="0,3,8,3"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.35"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="{DynamicResource Input}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="CaretBrush" Value="{DynamicResource Text}"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/><Setter Property="Padding" Value="10,8"/></Style>
  <Style TargetType="ListBox"><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/></Style>
  <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="10"/><Setter Property="Margin" Value="2,3"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="b" Background="{DynamicResource Alternate}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="b" Property="Background" Value="#DDF0F2"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#1672B6"/><Setter TargetName="b" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="DataGrid"><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="RowBackground" Value="{DynamicResource Surface}"/><Setter Property="AlternatingRowBackground" Value="{DynamicResource Alternate}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="RowHeight" Value="32"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource Raised}"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="Padding" Value="8"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="Padding" Value="6,2"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="TabItem"><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="tabBorder" Background="{DynamicResource Surface}" CornerRadius="7,7,0,0" Padding="12,8" Margin="0,0,5,0"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="tabBorder" Property="Background" Value="#DDF0F2"/><Setter Property="Foreground" Value="{DynamicResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="Expander"><Setter Property="Foreground" Value="{DynamicResource Text}"/></Style>
  <Style TargetType="PasswordBox"><Setter Property="Background" Value="{DynamicResource Input}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/><Setter Property="CaretBrush" Value="{DynamicResource Text}"/></Style>
  <Style TargetType="ToolTip"><Setter Property="Background" Value="{DynamicResource Raised}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/></Style>
  <Style TargetType="TabControl"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="DataGridRow"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoft}"/></Trigger></Style.Triggers></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="Padding" Value="10,7"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="item" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="item" Property="Background" Value="{DynamicResource AccentSoft}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="item" Property="Background" Value="{DynamicResource AccentSoft}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBox"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Background" Value="{DynamicResource Input}"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/><Setter Property="Padding" Value="9,7"/><Setter Property="MaxDropDownHeight" Value="300"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5"/><ContentPresenter Margin="10,6,28,6" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" IsHitTestVisible="False"/><ToggleButton IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Focusable="False" Background="Transparent"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"><TextBlock Text="▾" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource Muted}"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton><Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" PopupAnimation="None"><Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}"><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup></Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
 <Border Background="{DynamicResource Sidebar}" Padding="18"><DockPanel><TextBlock DockPanel.Dock="Bottom" Text="Im Tray weiterarbeiten
Fenster schließen = ausblenden" FontSize="11" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/><StackPanel><TextBlock Text="◈ Netzblick" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,30"/><Button x:Name="OverviewTab" Content="Programme"/><Button x:Name="LiveTab" Content="Programmdetails" Visibility="Collapsed"/><Button x:Name="AccessTab" Content="Einrichten &amp; testen" Background="{DynamicResource AccentSoft}"/><Button x:Name="InspectionTab" Content="Programm prüfen"/><Separator Margin="0,16"/><Button x:Name="OpenSetupRules" Content="Regeln"/><Button x:Name="OpenSetupHistory" Content="Verlauf"/><Button x:Name="UpdatesTab" Content="Updates"/></StackPanel></DockPanel></Border>
 <Grid Grid.Column="1" x:Name="MainShell" Margin="22">
  <Grid.RowDefinitions><RowDefinition Height="50"/><RowDefinition Height="0"/><RowDefinition Height="0"/><RowDefinition Height="*"/><RowDefinition Height="48"/></Grid.RowDefinitions>
  <DockPanel Grid.Row="0"><StackPanel DockPanel.Dock="Left"><TextBlock Text="Dein Netzwerk" FontSize="24" FontWeight="Bold"/><TextBlock x:Name="AccessGlobalStatus" Text="Beobachten · Kontrollmodus aus" Foreground="{DynamicResource Muted}"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock x:Name="FirewallStatus" Text="Firewall wird geprüft …" Margin="15,0"/><Button x:Name="Pause" Content="Ⅱ Ansicht pausieren"/><Button x:Name="ThemeToggle" Content="Dunkel"/><Button x:Name="Export" Content="CSV exportieren"/></StackPanel></DockPanel>
  <UniformGrid x:Name="SummaryMetrics" Grid.Row="1" Columns="4" Visibility="Collapsed">
   <Border Background="{DynamicResource Surface}" CornerRadius="8" Margin="0,0,12,0" Padding="16"><StackPanel><TextBlock Text="↓ Empfang · Adapter gesamt" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="Download" Text="—" FontSize="25" Foreground="{DynamicResource Accent}"/></StackPanel></Border>
   <Border Background="{DynamicResource Surface}" CornerRadius="8" Margin="0,0,12,0" Padding="16"><StackPanel><TextBlock Text="↑ Versand · Adapter gesamt" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="Upload" Text="—" FontSize="25" Foreground="{DynamicResource Blue}"/></StackPanel></Border>
   <Border Background="{DynamicResource Surface}" CornerRadius="8" Margin="0,0,12,0" Padding="16"><StackPanel><TextBlock Text="TCP verbunden / UDP-Endpunkte" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="Count" Text="—" FontSize="25"/></StackPanel></Border>
   <Border Background="{DynamicResource Surface}" CornerRadius="8" Padding="16"><StackPanel><TextBlock Text="Frühere Windows-Regeln" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="BlockedCount" Text="—" FontSize="25" Foreground="{DynamicResource Danger}"/></StackPanel></Border>
  </UniformGrid>
  <DockPanel Grid.Row="2"><CheckBox x:Name="ResolveNames" DockPanel.Dock="Right" Content="DNS-Namen ergänzen" VerticalAlignment="Center" ToolTip="Optional: zusätzliche Reverse-DNS-Abfragen; Namen belegen keinen Verbindungszweck."/><TextBox x:Name="Search" Width="250" Height="36" Visibility="Collapsed" HorizontalAlignment="Left" ToolTip="Programm, IP-Adresse, Port oder PID suchen"/></DockPanel>
<Grid Grid.Row="3" x:Name="LivePanel" Visibility="Collapsed">
 <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <ListBox x:Name="Programs" Visibility="Collapsed"/>
 <Border Background="{DynamicResource Surface}" CornerRadius="10" Padding="16" Margin="0,0,0,12"><DockPanel>
  <Button x:Name="BackToPrograms" DockPanel.Dock="Left" Content="← Programme" Margin="0,0,18,0"/>
  <Button x:Name="ProgramAccessRules" DockPanel.Dock="Right" Content="Zugriff ändern" IsEnabled="False" Background="{DynamicResource AccentSoft}"/>
  <StackPanel><DockPanel><Ellipse x:Name="ProgramSignal" DockPanel.Dock="Left" Width="12" Height="12" Fill="{DynamicResource Muted}" Margin="0,0,10,0"/><TextBlock x:Name="ProgramTitle" Text="Programm auswählen" FontSize="24" FontWeight="SemiBold"/></DockPanel><TextBlock x:Name="ProgramShortState" Text="" Foreground="{DynamicResource Muted}" Margin="22,5,0,0" TextWrapping="Wrap"/></StackPanel>
 </DockPanel></Border>
 <TabControl x:Name="ProgramDetailTabs" Grid.Row="1" Background="Transparent" BorderThickness="0">
  <TabItem Header="Übersicht"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,14,0,0">
   <Border Background="{DynamicResource AccentSoft}" CornerRadius="10" Padding="20"><StackPanel><TextBlock x:Name="ProgramExplanation" Text="Ein Programm auswählen." FontSize="19" TextWrapping="Wrap"/><TextBlock x:Name="ProgramEvidenceSummary" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{DynamicResource Muted}"/><Button x:Name="ShowProgramBlocks" Content="Blockversuche anzeigen" HorizontalAlignment="Left" Margin="0,12,0,0" Background="{DynamicResource WarningSoft}"/></StackPanel></Border>
   <Grid Margin="0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource Surface}" CornerRadius="10" Padding="18" Margin="0,0,12,0"><StackPanel><TextBlock Text="AKTUELLER ZUGRIFF" FontSize="11" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="ProgramStatus" TextWrapping="Wrap" Margin="0,10"/><TextBlock Text="Die Ampel beschreibt Netzblicks aktuelle Einstellung. Andere Sicherheitsregeln können zusätzlich wirken." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12"/><Expander Header="Ältere Windows-Regeln verwalten" Margin="0,14,0,0"><StackPanel><Button x:Name="ModeDefault" Content="Windows-Standard" IsEnabled="False"/><Button x:Name="ModePrivate" Content="Nur private Netze" IsEnabled="False"/><Button x:Name="ModeBlocked" Content="Netzwerk sperren" IsEnabled="False" Background="{DynamicResource DangerSoft}"/><Button x:Name="ShowOwnRules" Content="Alte Regeln ansehen"/></StackPanel></Expander></StackPanel></Border>
    <Border Grid.Column="1" Background="{DynamicResource Surface}" CornerRadius="10" Padding="18"><StackPanel><TextBlock Text="DATEN IN DIESER SITZUNG" FontSize="11" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="ProgramTraffic" TextWrapping="Wrap" Margin="0,10"/><WrapPanel><Button x:Name="ShowProgramMap" Content="Weltkarte öffnen"/><Button x:Name="ShowDiagnostics" Content="Ping / Traceroute"/><Button x:Name="ShowHistory" Content="Verlauf"/></WrapPanel></StackPanel></Border>
   </Grid>
   <Expander Header="Programmpfad" Margin="0,0,0,12"><TextBox x:Name="ProgramPath" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"/></Expander>
   <Expander x:Name="ProgramMapExpander" Header="Verbindungskarte (optional)" IsExpanded="False"><Border Background="{DynamicResource Surface}" Padding="14" CornerRadius="10"><StackPanel><Viewbox Height="240" Stretch="Uniform"><Canvas x:Name="Map" Width="600" Height="240"/></Viewbox><TextBlock Text="Linien zeigen beobachtete Gegenstellen, keine gemessene Flussrichtung." FontSize="11" Foreground="{DynamicResource Muted}"/></StackPanel></Border></Expander>
  </StackPanel></ScrollViewer></TabItem>
  <TabItem Header="Verbindungen"><Grid Margin="0,14,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="210"/></Grid.RowDefinitions>
   <StackPanel><CheckBox x:Name="OnlyProgramBlocks" Content="Nur blockierte Versuche" Margin="4,0,0,8"/><TextBlock x:Name="ProgramBlockHint" Foreground="{DynamicResource Warning}" TextWrapping="Wrap" Margin="4,0,0,10"/></StackPanel>
   <DataGrid x:Name="Connections" Grid.Row="1" SelectionMode="Single"><DataGrid.Columns><DataGridTextColumn Header="Typ" Binding="{Binding Protocol}" Width="70"/><DataGridTextColumn Header="Gegenstelle (IP)" Binding="{Binding Remote}" Width="180"/><DataGridTextColumn Header="Name / Bereich" Binding="{Binding PeerName}" Width="180"/><DataGridTextColumn Header="Diensthinweis" Binding="{Binding ServiceHint}" Width="170"/><DataGridTextColumn Header="Status" Binding="{Binding State}" Width="170"/><DataGridTextColumn Header="Sperrgrund / Filter" Binding="{Binding BlockReason}" Width="300"/><DataGridTextColumn Header="Lokal" Binding="{Binding Local}" Width="160"/></DataGrid.Columns></DataGrid>
   <Grid Grid.Row="2" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="{DynamicResource WarningSoft}" CornerRadius="8" Padding="14" Margin="0,0,12,0"><ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock x:Name="BlockReasonText" TextWrapping="Wrap"/></ScrollViewer></Border><Border Grid.Column="1" Background="{DynamicResource Surface}" CornerRadius="8" Padding="14"><ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock x:Name="SocketDetails" Text="Eine Gegenstelle auswählen." TextWrapping="Wrap"/></ScrollViewer></Border></Grid>
  </Grid></TabItem>
  <TabItem Header="Regeln"><DockPanel Margin="0,14,0,0"><StackPanel DockPanel.Dock="Top"><TextBlock Text="Regeln für dieses Programm" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Eigene Dienstregeln, Prüfsperre und allgemeiner Nachfragemodus. Änderungen gelten für neue Verbindungen." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,8"/><WrapPanel><Button x:Name="ProgramRuleRemove" Content="Ausgewählten Eintrag zurücknehmen …" IsEnabled="False"/><Button x:Name="ProgramRulesManage" Content="Alle Sperren &amp; Freigaben verwalten"/></WrapPanel><TextBlock x:Name="ProgramRulesHint" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,8"/></StackPanel><DataGrid x:Name="ProgramRules" SelectionMode="Single"><DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="240"/><DataGridTextColumn Header="Aktion" Binding="{Binding ActionLabel}" Width="85"/><DataGridTextColumn Header="Gilt für" Binding="{Binding Scope}" Width="*" MinWidth="260"/><DataGridTextColumn Header="Gültigkeit" Binding="{Binding Lifetime}" Width="130"/></DataGrid.Columns></DataGrid></DockPanel></TabItem>
 </TabControl>
</Grid>
  <Border Grid.Row="3" x:Name="RulesPanel" Visibility="Collapsed" Background="{DynamicResource Surface}" CornerRadius="8" Padding="18"><DockPanel><StackPanel DockPanel.Dock="Top"><Button x:Name="BackFromRules" Content="← Zurück zu Programme" HorizontalAlignment="Left"/><TextBlock Text="Deine Netzblick-Sperren" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Hier bleiben auch Sperren beendeter Programme sichtbar. Fremde Regeln werden nicht verändert." Margin="0,10,0,10" Foreground="{DynamicResource Muted}"/><Button x:Name="RemoveRule" Content="Ausgewählte Programm-Sperre entfernen" HorizontalAlignment="Left"/></StackPanel><DataGrid x:Name="Rules"><DataGrid.Columns><DataGridTextColumn Header="Programm" Binding="{Binding Program}" Width="180"/><DataGridTextColumn Header="Pfad" Binding="{Binding Path}" Width="*"/><DataGridTextColumn Header="Richtung" Binding="{Binding Direction}" Width="140"/><DataGridCheckBoxColumn Header="Aktiv" Binding="{Binding Enabled}" Width="80"/></DataGrid.Columns></DataGrid></DockPanel></Border>
  <Border Grid.Row="3" x:Name="HistoryPanel" Visibility="Collapsed" Background="{DynamicResource Surface}" CornerRadius="8" Padding="18"><DockPanel><StackPanel DockPanel.Dock="Top"><Button x:Name="BackFromHistory" Content="← Zurück zu Programme" HorizontalAlignment="Left"/><TextBlock Text="Beobachteter Verlauf" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Neu beobachtete Sockets und eigene Regeländerungen · maximal 500 Einträge · nur in dieser Sitzung" Margin="0,10,0,16" Foreground="{DynamicResource Muted}"/></StackPanel><DataGrid x:Name="History"><DataGrid.Columns><DataGridTextColumn Header="Zeit" Binding="{Binding Time}" Width="90"/><DataGridTextColumn Header="Ereignis" Binding="{Binding Event}" Width="180"/><DataGridTextColumn Header="Programm" Binding="{Binding Program}" Width="170"/><DataGridTextColumn Header="Details" Binding="{Binding Detail}" Width="*"/></DataGrid.Columns></DataGrid></DockPanel></Border>
  <ContentControl Grid.Row="3" x:Name="AccessPanel" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
  <ContentControl Grid.Row="3" x:Name="UpdatesPanel" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/><ContentControl Grid.Row="3" x:Name="OverviewPanel" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
  <ContentControl Grid.Row="3" x:Name="WorldPanel" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
  <ContentControl Grid.Row="3" x:Name="TerminalPanel" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
  <ContentControl Grid.Row="3" x:Name="InspectionPanel" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
  <DockPanel Grid.Row="4"><TextBlock x:Name="UserNotice" DockPanel.Dock="Right" Foreground="{DynamicResource Warning}" Margin="15,0"/><TextBlock x:Name="Status" Text="Starte lokale Erfassung …" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="12"/></DockPanel>
 </Grid>
 </Grid>
</Window>


