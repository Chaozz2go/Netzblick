<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Netzblick · 0.6.0" Width="1440" Height="920" MinWidth="1120" MinHeight="760" Background="#0C1522" Foreground="#E5EDF7" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <SolidColorBrush x:Key="Panel" Color="#142235"/>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E5EDF7"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style TargetType="Button"><Setter Property="Background" Value="#20364E"/><Setter Property="Foreground" Value="#E5EDF7"/><Setter Property="BorderBrush" Value="#35516B"/><Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="0,3,8,3"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.35"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#0E1A2A"/><Setter Property="Foreground" Value="#E5EDF7"/><Setter Property="CaretBrush" Value="White"/><Setter Property="BorderBrush" Value="#35516B"/><Setter Property="Padding" Value="10,8"/></Style>
  <Style TargetType="ListBox"><Setter Property="Background" Value="#142235"/><Setter Property="Foreground" Value="#E5EDF7"/><Setter Property="BorderThickness" Value="0"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/></Style>
  <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="10"/><Setter Property="Margin" Value="2,3"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="b" Background="#192C42" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="b" Property="Background" Value="#24547B"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#4EA5FF"/><Setter TargetName="b" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="DataGrid"><Setter Property="Background" Value="#142235"/><Setter Property="Foreground" Value="#E5EDF7"/><Setter Property="RowBackground" Value="#142235"/><Setter Property="AlternatingRowBackground" Value="#192C42"/><Setter Property="BorderThickness" Value="0"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="RowHeight" Value="32"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#20364E"/><Setter Property="Foreground" Value="#B6CDE3"/><Setter Property="Padding" Value="8"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="Padding" Value="6,2"/><Setter Property="BorderThickness" Value="0"/></Style>
 </Window.Resources>
 <Grid x:Name="MainShell" Margin="22">
  <Grid.RowDefinitions><RowDefinition Height="65"/><RowDefinition Height="0"/><RowDefinition Height="62"/><RowDefinition Height="*"/><RowDefinition Height="48"/></Grid.RowDefinitions>
  <DockPanel Grid.Row="0"><StackPanel DockPanel.Dock="Left"><TextBlock Text="◈  Netzblick" FontSize="28" FontWeight="Bold"/><TextBlock x:Name="AccessGlobalStatus" Text="Beobachten · Kontrollmodus aus" Foreground="#A8C1D9"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock x:Name="FirewallStatus" Text="Firewall wird geprüft …" Margin="15,0"/><Button x:Name="Pause" Content="Ⅱ Ansicht pausieren"/><Button x:Name="Export" Content="CSV exportieren"/></StackPanel></DockPanel>
  <UniformGrid x:Name="SummaryMetrics" Grid.Row="1" Columns="4" Visibility="Collapsed">
   <Border Background="{StaticResource Panel}" CornerRadius="8" Margin="0,0,12,0" Padding="16"><StackPanel><TextBlock Text="↓ Empfang · Adapter gesamt" Foreground="#8CAAC8"/><TextBlock x:Name="Download" Text="—" FontSize="25" Foreground="#39DCC0"/></StackPanel></Border>
   <Border Background="{StaticResource Panel}" CornerRadius="8" Margin="0,0,12,0" Padding="16"><StackPanel><TextBlock Text="↑ Versand · Adapter gesamt" Foreground="#8CAAC8"/><TextBlock x:Name="Upload" Text="—" FontSize="25" Foreground="#4EA5FF"/></StackPanel></Border>
   <Border Background="{StaticResource Panel}" CornerRadius="8" Margin="0,0,12,0" Padding="16"><StackPanel><TextBlock Text="TCP verbunden / UDP-Endpunkte" Foreground="#8CAAC8"/><TextBlock x:Name="Count" Text="—" FontSize="25"/></StackPanel></Border>
   <Border Background="{StaticResource Panel}" CornerRadius="8" Padding="16"><StackPanel><TextBlock Text="Eigene Einschränkungen" Foreground="#8CAAC8"/><TextBlock x:Name="BlockedCount" Text="—" FontSize="25" Foreground="#FF7E85"/></StackPanel></Border>
  </UniformGrid>
  <DockPanel Grid.Row="2"><StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><Button x:Name="AccessTab" Content="Zugriff entscheiden" Background="#24547B"/><Button x:Name="OverviewTab" Content="Aktivität"/><Button x:Name="LiveTab" Content="Programme"/><Button x:Name="InspectionTab" Content="Programm prüfen"/></StackPanel><CheckBox x:Name="ResolveNames" DockPanel.Dock="Right" Content="DNS-Namen ergänzen" Foreground="#A8C1D9" VerticalAlignment="Center" Margin="12,0" ToolTip="Optional: Windows fragt Reverse-DNS-Namen beim konfigurierten DNS-Server ab. Zusätzliche Anfragen von Netzblick, auch während einer Prüfung. Pro Ansicht werden bis zu 100 Einträge ergänzt. IP und Port bleiben sichtbar; Namen belegen weder Betreiber noch Verbindungszweck."/><TextBox x:Name="Search" Width="200" Height="36" Visibility="Collapsed" HorizontalAlignment="Right" ToolTip="Programm, IP-Adresse, Port oder PID suchen"/></DockPanel>
  <Grid Grid.Row="3" x:Name="LivePanel" Visibility="Collapsed">
   <Grid.ColumnDefinitions><ColumnDefinition Width="245"/><ColumnDefinition Width="*"/><ColumnDefinition Width="285"/></Grid.ColumnDefinitions>
   <Border Background="{StaticResource Panel}" CornerRadius="8" Padding="10" Margin="0,0,12,0"><DockPanel><TextBlock DockPanel.Dock="Top" Text="PROGRAMME" Margin="8,6,0,14" FontWeight="SemiBold" Foreground="#91ADC8"/><ListBox x:Name="Programs"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="{Binding Summary}" Foreground="#A8C1D9" FontSize="11" Margin="0,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border>
   <Grid Grid.Column="1" Margin="0,0,12,0"><Grid.RowDefinitions><RowDefinition Height="320"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Background="{StaticResource Panel}" CornerRadius="8" Padding="14" Margin="0,0,0,12"><DockPanel><TextBlock DockPanel.Dock="Top" Text="VERBINDUNGSKARTE · ausgewähltes Programm" FontWeight="SemiBold" Foreground="#91ADC8" Margin="0,0,0,12"/><TextBlock DockPanel.Dock="Bottom" Text="Linien zeigen Gegenstellen, keine gemessene Flussrichtung." Foreground="#91ADC8" FontSize="11"/><Viewbox Stretch="Uniform"><Canvas x:Name="Map" Width="600" Height="240"/></Viewbox></DockPanel></Border>
    <Border Grid.Row="1" Background="{StaticResource Panel}" CornerRadius="8" Padding="10"><DockPanel><TextBlock DockPanel.Dock="Top" Text="GEGENSTELLEN · Sockets und ETW-Beobachtungen" Margin="4,2,0,12" Foreground="#91ADC8"/><DataGrid x:Name="Connections"><DataGrid.Columns><DataGridTextColumn Header="Typ" Binding="{Binding Protocol}" Width="65"/><DataGridTextColumn Header="Gegenstelle (IP)" Binding="{Binding Remote}" Width="180"/><DataGridTextColumn Header="Name / Bereich" Binding="{Binding PeerName}" Width="180"/><DataGridTextColumn Header="Diensthinweis" Binding="{Binding ServiceHint}" Width="180"/><DataGridTextColumn Header="Status" Binding="{Binding State}" Width="110"/><DataGridTextColumn Header="Lokal" Binding="{Binding Local}" Width="160"/></DataGrid.Columns></DataGrid></DockPanel></Border>
   </Grid>
   <Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="8" Padding="18"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock x:Name="ProgramTitle" Text="Programm auswählen" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="ProgramStatus" Foreground="#F5C477" Margin="0,10,0,12" TextWrapping="Wrap"/><TextBlock Text="PROGRAMMPFAD" Foreground="#91ADC8"/><TextBox x:Name="ProgramPath" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Margin="0,7,0,16"/><TextBlock Text="NETZWERKZUGRIFF" Foreground="#91ADC8" Margin="0,0,0,8"/><Button x:Name="ModeDefault" Content="Windows-Standard" IsEnabled="False" ToolTip="Nur eigene Netzblick-Einschränkungen entfernen; andere Regeln bleiben wirksam."/><Button x:Name="ModePrivate" Content="Nur private Netze" IsEnabled="False" ToolTip="Auf private, lokale und ausgewählte Multicast-Adressbereiche beschränken; umfasst auch VPNs. Andere Windows-Regeln bleiben wirksam."/><Button x:Name="ModeBlocked" Content="Netzwerk sperren" Background="#602D3A" BorderBrush="#FF6D7A" IsEnabled="False"/><TextBlock x:Name="ProgramTraffic" Text="Datenmessung wird vorbereitet …" Foreground="#A8C1D9" TextWrapping="Wrap" Margin="0,12,0,0"/><TextBlock Text="DETAILS UND HILFE" Foreground="#91ADC8" Margin="0,18,0,8"/><Button x:Name="ShowProgramMap" Content="Gegenstellen auf der Karte"/><Button x:Name="ShowDiagnostics" Content="Ping und Traceroute"/><Button x:Name="ShowOwnRules" Content="Eigene Regeln prüfen"/><Button x:Name="ShowHistory" Content="Verlauf ansehen"/><TextBlock Text="Die Einstellung gilt für diesen EXE-Pfad und bleibt nach dem Schließen aktiv. Windows-Standard ist keine zusätzliche Freigabe." TextWrapping="Wrap" Foreground="#91ADC8" FontSize="12" Margin="0,12,0,18"/><Separator Background="#35516B"/><TextBlock Text="VERBINDUNGSDETAILS" Foreground="#91ADC8" Margin="0,14,0,10"/><TextBlock x:Name="SocketDetails" Text="Eine Tabellenzeile auswählen." TextWrapping="Wrap"/><TextBlock Text="TLS-Inhalte werden nicht entschlüsselt. Eine offene Verbindung ist kein Nachweis für laufenden Datentransfer. UDP-Gegenstellen ergänzt die ETW-Messung, sofern verfügbar." TextWrapping="Wrap" Foreground="#91ADC8" FontSize="12" Margin="0,22,0,0"/></StackPanel></ScrollViewer></Border>
  </Grid>
  <Border Grid.Row="3" x:Name="RulesPanel" Visibility="Collapsed" Background="{StaticResource Panel}" CornerRadius="8" Padding="18"><DockPanel><StackPanel DockPanel.Dock="Top"><Button x:Name="BackFromRules" Content="← Zurück zu Programme" HorizontalAlignment="Left"/><TextBlock Text="Deine Netzblick-Sperren" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Hier bleiben auch Sperren beendeter Programme sichtbar. Fremde Regeln werden nicht verändert." Margin="0,10,0,10" Foreground="#91ADC8"/><Button x:Name="RemoveRule" Content="Ausgewählte Programm-Sperre entfernen" HorizontalAlignment="Left"/></StackPanel><DataGrid x:Name="Rules"><DataGrid.Columns><DataGridTextColumn Header="Programm" Binding="{Binding Program}" Width="180"/><DataGridTextColumn Header="Pfad" Binding="{Binding Path}" Width="*"/><DataGridTextColumn Header="Richtung" Binding="{Binding Direction}" Width="140"/><DataGridCheckBoxColumn Header="Aktiv" Binding="{Binding Enabled}" Width="80"/></DataGrid.Columns></DataGrid></DockPanel></Border>
  <Border Grid.Row="3" x:Name="HistoryPanel" Visibility="Collapsed" Background="{StaticResource Panel}" CornerRadius="8" Padding="18"><DockPanel><StackPanel DockPanel.Dock="Top"><Button x:Name="BackFromHistory" Content="← Zurück zu Programme" HorizontalAlignment="Left"/><TextBlock Text="Beobachteter Verlauf" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Neu beobachtete Sockets und eigene Regeländerungen · maximal 500 Einträge · nur in dieser Sitzung" Margin="0,10,0,16" Foreground="#91ADC8"/></StackPanel><DataGrid x:Name="History"><DataGrid.Columns><DataGridTextColumn Header="Zeit" Binding="{Binding Time}" Width="90"/><DataGridTextColumn Header="Ereignis" Binding="{Binding Event}" Width="180"/><DataGridTextColumn Header="Programm" Binding="{Binding Program}" Width="170"/><DataGridTextColumn Header="Details" Binding="{Binding Detail}" Width="*"/></DataGrid.Columns></DataGrid></DockPanel></Border>
  <ContentControl Grid.Row="3" x:Name="AccessPanel" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
  <ContentControl Grid.Row="3" x:Name="OverviewPanel" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
  <ContentControl Grid.Row="3" x:Name="WorldPanel" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
  <ContentControl Grid.Row="3" x:Name="TerminalPanel" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
  <ContentControl Grid.Row="3" x:Name="InspectionPanel" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
  <DockPanel Grid.Row="4"><TextBlock x:Name="UserNotice" DockPanel.Dock="Right" Foreground="#F5C477" Margin="15,0"/><TextBlock x:Name="Status" Text="Starte lokale Erfassung …" Foreground="#91ADC8" TextWrapping="Wrap" FontSize="12"/></DockPanel>
 </Grid>
</Window>
