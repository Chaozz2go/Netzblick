<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
      <TextBlock Text="Benachrichtigungen" FontSize="25" FontWeight="SemiBold"/>
      <TextBlock Text="Wähle, wann Netzblick dich mit einem Pop-up benachrichtigt."
                 Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,6,0,14"/>
      <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
              BorderThickness="1" Padding="20">
        <StackPanel>
          <CheckBox x:Name="EnableNotificationPopups" Content="Pop-ups anzeigen" IsChecked="True"
                    FontSize="17" FontWeight="SemiBold"/>
          <TextBlock Text="Bei ausgeschalteten Pop-ups findest du neue Programme und blockierte Verbindungen weiterhin in Netzblick."
                     Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,8,0,16"/>
          <CheckBox x:Name="NotifyObservedPrograms" Content="Neue Programme melden" IsChecked="True"
                    Margin="0,0,0,10"/>
          <CheckBox x:Name="NotifyAttempts" Content="Blockierte Verbindungsversuche im Tray melden"
                    IsChecked="True" Margin="0,0,0,10"/>
          <CheckBox x:Name="NotifyTargets" Content="Auch neue Ziele bekannter Programme melden"
                    Margin="18,0,0,0" ToolTip="Kann bei Browsern viele Hinweise erzeugen."/>
          <TextBlock x:Name="NotificationSaveError" Foreground="{DynamicResource Warning}"
                     TextWrapping="Wrap" Margin="0,10,0,0"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Grid>
