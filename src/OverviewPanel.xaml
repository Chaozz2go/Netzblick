<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="88"/><RowDefinition Height="*"/><RowDefinition Height="76"/></Grid.RowDefinitions>
 <Border Background="White" CornerRadius="8" Padding="14" Margin="0,0,0,10"><StackPanel>
  <DockPanel><TextBlock Text="Neue Verbindungen" FontSize="18" FontWeight="SemiBold" DockPanel.Dock="Left"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><CheckBox x:Name="NotifyObservedPrograms" Content="Hinweis bei neuen Programmen" IsChecked="True" VerticalAlignment="Center" Margin="0,0,15,0"/><Button x:Name="OverviewPermissions" Content="Sperren &amp; Freigaben"/><Button x:Name="OverviewShowPrograms" Content="Alle Programme"/></StackPanel></DockPanel>
  <ComboBox x:Name="ReviewPolicy" SelectedIndex="0" Margin="0,8,0,6" Padding="8" MaxWidth="650" HorizontalAlignment="Left"><ComboBoxItem Content="Zulassen und anschließend prüfen (Standard)"/><ComboBoxItem Content="Unbekannte Verbindungen bis zur Freigabe sperren"/></ComboBox>
  <TextBlock x:Name="ReviewPolicyHint" Text="Neue Programme dürfen zunächst kommunizieren. Netzblick meldet sie zur Prüfung." TextWrapping="Wrap" Foreground="#57677B"/>
 </StackPanel></Border>
 <Border Grid.Row="1" Background="#E8F2F5" CornerRadius="8" Padding="14" Margin="0,0,0,10"><StackPanel>
  <DockPanel><TextBlock Text="NOCH ZU PRÜFEN" FontSize="11" Foreground="#57677B"/><TextBlock x:Name="OverviewNew" Text="0" FontSize="20" FontWeight="SemiBold" Margin="12,0"/><TextBlock x:Name="NewProgramsNotice" Text="Ausgangsbestand wird erfasst …" TextWrapping="Wrap"/></DockPanel>
  <DockPanel Margin="0,8,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="ReviewShow" Content="Anzeigen"/><Button x:Name="ReviewBlock" Content="Sperren" Background="#F9E5E7"/><Button x:Name="ReviewDone" Content="Als geprüft markieren" ToolTip="Ändert keine Firewallregel und gibt keine Verbindung frei."/><Button x:Name="AcknowledgeNew" Content="Alle geprüft" ToolTip="Markiert die Prüfliste, ohne Firewallregeln zu ändern."/></StackPanel><ComboBox x:Name="PendingPrograms" DisplayMemberPath="Name" MinWidth="160" MaxWidth="340" Padding="7"/></DockPanel>
  <TextBlock x:Name="ReviewTargets" Text="Programm auswählen, um seine Gegenstellen zu sehen." TextWrapping="Wrap" Foreground="#57677B" Margin="0,8,0,0" MaxHeight="62"/>
 </StackPanel></Border>
 <StackPanel Grid.Row="2"><TextBlock Text="Was kommuniziert auf deinem PC?" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Rot: gesperrt · Gelb: teilweise · Grün: Netzblick lässt durch · Grau: Status unbekannt" FontSize="11" Foreground="#57677B" TextWrapping="Wrap" Margin="0,5,0,0"/><TextBlock x:Name="OverviewStatus" Text="Datenmessung wird vorbereitet …" Foreground="#57677B" FontSize="12" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel>
 <DataGrid Grid.Row="3" x:Name="OverviewPrograms" SelectionMode="Single"><DataGrid.Columns><DataGridTemplateColumn Header="Programm" Width="*" MinWidth="180"><DataGridTemplateColumn.CellTemplate><DataTemplate><DockPanel ToolTip="{Binding SignalHint}" Margin="4,0"><Ellipse DockPanel.Dock="Left" Width="10" Height="10" Fill="{Binding SignalColor}" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DockPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Prüfung" Binding="{Binding Review}" Width="145"/><DataGridTextColumn Header="Netzblick-Einstellung" Binding="{Binding Status}" Width="220"/><DataGridTextColumn Header="Gesendet" Binding="{Binding Sent}" Width="90"/><DataGridTextColumn Header="Empfangen" Binding="{Binding Received}" Width="90"/><DataGridTextColumn Header="Rate" Binding="{Binding Rate}" Width="200"/></DataGrid.Columns></DataGrid>
 <Border Grid.Row="4" Background="White" CornerRadius="8" Padding="12" Margin="0,12,0,0"><DockPanel><Button x:Name="ResetNetzblick" DockPanel.Dock="Right" Content="Alles neu prüfen …"/><Button x:Name="UndoNetwork" DockPanel.Dock="Right" Content="Letzte Änderung rückgängig" IsEnabled="False"/><StackPanel><TextBlock Text="LETZTE NETZWERKÄNDERUNG" Foreground="#57677B" FontSize="11"/><TextBlock x:Name="LastNetworkChange" Text="Noch keine aufgezeichnete Änderung." Margin="0,5,0,0"/></StackPanel></DockPanel></Border>
</Grid>
