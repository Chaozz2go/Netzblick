<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid.RowDefinitions><RowDefinition Height="90"/><RowDefinition Height="74"/><RowDefinition Height="*"/><RowDefinition Height="76"/></Grid.RowDefinitions>
 <Border Background="#142235" CornerRadius="8" Padding="16" Margin="0,0,0,12"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="OverviewShowPrograms" Content="Programme verwalten"/><Button x:Name="AcknowledgeNew" Content="Als gesehen markieren"/></StackPanel><StackPanel><TextBlock Text="NEU BEOBACHTET" Foreground="#91ADC8" FontSize="11"/><StackPanel Orientation="Horizontal"><TextBlock x:Name="OverviewNew" Text="0" FontSize="28" Foreground="#F5C477" Margin="0,0,16,0"/><TextBlock x:Name="NewProgramsNotice" Text="Ausgangsbestand wird erfasst …" TextWrapping="Wrap" MaxWidth="700"/></StackPanel></StackPanel></DockPanel></Border>
 <StackPanel Grid.Row="1"><TextBlock Text="Was kommuniziert auf deinem PC?" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="OverviewStatus" Text="Datenmessung wird vorbereitet …" Foreground="#91ADC8" FontSize="12" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel>
 <DataGrid Grid.Row="2" x:Name="OverviewPrograms" SelectionMode="Single"><DataGrid.Columns><DataGridTextColumn Header="Programm" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Netzblick-Einstellung" Binding="{Binding Status}" Width="250"/><DataGridTextColumn Header="Gesendet" Binding="{Binding Sent}" Width="110"/><DataGridTextColumn Header="Empfangen" Binding="{Binding Received}" Width="110"/><DataGridTextColumn Header="Zuletzt gemessene Rate" Binding="{Binding Rate}" Width="240"/></DataGrid.Columns></DataGrid>
 <Border Grid.Row="3" Background="#142235" CornerRadius="8" Padding="12" Margin="0,12,0,0"><DockPanel><Button x:Name="UndoNetwork" DockPanel.Dock="Right" Content="Letzte Änderung rückgängig" IsEnabled="False"/><StackPanel><TextBlock Text="LETZTE NETZWERKÄNDERUNG" Foreground="#91ADC8" FontSize="11"/><TextBlock x:Name="LastNetworkChange" Text="Noch keine aufgezeichnete Änderung." Margin="0,5,0,0"/></StackPanel></DockPanel></Border>
</Grid>
