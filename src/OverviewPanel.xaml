<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid.Resources><Style x:Key="StatFilterStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="12"/><Setter Property="Margin" Value="0,0,6,0"/><Setter Property="Background" Value="{DynamicResource Raised}"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Card" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource CardCorner}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Opacity" Value="0.85"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="Card" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></Grid.Resources>
 <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel Margin="0,0,0,16"><UniformGrid x:Name="FutureStats" Columns="3" Visibility="Collapsed" Margin="0,0,0,12">
 <Button x:Name="FutureAllFilter" Tag="0" Style="{StaticResource StatFilterStyle}" ToolTip="Alle Programme anzeigen"><StackPanel><TextBlock x:Name="FutureProgramCount" Text="0" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Programme" Foreground="{DynamicResource Muted}"/></StackPanel></Button>
 <Button x:Name="FutureBlockedFilter" Tag="1" Style="{StaticResource StatFilterStyle}" ToolTip="Gesperrte Programme anzeigen"><StackPanel><TextBlock x:Name="FutureBlockedCount" Text="0" FontSize="24" Foreground="{DynamicResource Danger}" FontWeight="SemiBold"/><TextBlock Text="gesperrt" Foreground="{DynamicResource Muted}"/></StackPanel></Button>
 <Button x:Name="FutureReviewFilter" Tag="2" Style="{StaticResource StatFilterStyle}" ToolTip="Programme mit offenen Prüfungen anzeigen"><StackPanel><TextBlock x:Name="FutureReviewCount" Text="0" FontSize="24" Foreground="{DynamicResource Warning}" FontWeight="SemiBold"/><TextBlock Text="zu prüfen" Foreground="{DynamicResource Muted}"/></StackPanel></Button>
 </UniformGrid><DockPanel><TextBlock x:Name="ProgramListTitle" Text="Deine Programme" FontSize="27" FontWeight="SemiBold"/><TextBlock x:Name="ProgramListCounts" HorizontalAlignment="Right" Foreground="{DynamicResource Muted}"/></DockPanel><TextBlock x:Name="ProgramListHint" TextWrapping="Wrap" Text="Ampel = aktueller Zugriff · Blockzähler = erfasste Ereignisse · Doppelklick öffnet die Details" Foreground="{DynamicResource Muted}" Margin="0,6,0,0"/><TextBlock x:Name="OverviewStatus" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
 <StackPanel Grid.Row="1" Margin="0,0,0,10">
 <Border x:Name="ReviewSummaryCard" Background="{DynamicResource AccentSoft}" CornerRadius="{DynamicResource CardCorner}" Padding="10" Margin="0,0,0,6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="OverviewNew" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="NewProgramsNotice" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,3,6,0"/></StackPanel><Button x:Name="ReviewShow" Grid.Column="1" Content="Prüfliste →" VerticalAlignment="Center" ToolTip="Alle offenen Prüfungen in der Programmliste anzeigen"/></Grid></Border>
 <Expander x:Name="ReviewOptions" Header="Erkennung &amp; Hinweise" IsExpanded="False"><StackPanel Margin="0,8,0,0">
 <ComboBox x:Name="ReviewPolicy" SelectedIndex="0" HorizontalAlignment="Stretch" Padding="7"><ComboBoxItem Content="Zulassen und anschließend prüfen (Standard)"/><ComboBoxItem Content="Unbekannte Verbindungen bis zur Freigabe sperren"/></ComboBox><CheckBox x:Name="NotifyObservedPrograms" Content="Hinweis bei neuen Programmen" IsChecked="True" Margin="0,8,0,0"/><TextBlock x:Name="ReviewPolicyHint" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,6,0,0"/>
 </StackPanel></Expander></StackPanel>
 <Grid Grid.Row="2" Margin="0,0,0,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBox x:Name="OverviewSearch" ToolTip="Programm oder EXE-Pfad suchen" Margin="0,0,0,8"/><DockPanel Grid.Row="1"><TextBlock Text="Anzeigen" Margin="0,0,10,0" Foreground="{DynamicResource Muted}" DockPanel.Dock="Left"/><ComboBox x:Name="OverviewFilter" SelectedIndex="0" Width="190" HorizontalAlignment="Left" Padding="7"><ComboBoxItem Content="Alle Programme"/><ComboBoxItem Content="Gesperrt"/><ComboBoxItem Content="Zu prüfen"/><ComboBoxItem Content="Gerade aktiv"/><ComboBoxItem Content="Dateiänderungen"/></ComboBox><TextBlock x:Name="ProgramSearchHint" Text="Suche nach Name / Pfad" Foreground="{DynamicResource Muted}" Margin="16,0,0,0"/></DockPanel></Grid>
 <DataGrid x:Name="OverviewPrograms" Grid.Row="3" SelectionMode="Single" RowHeight="90"><DataGrid.Columns><DataGridTemplateColumn Header="Programm / Blockversuche" Width="*" MinWidth="260"><DataGridTemplateColumn.CellTemplate><DataTemplate><DockPanel ToolTip="{Binding SignalHint}" Margin="5,0"><Image DockPanel.Dock="Left" Source="{Binding AppIcon}" Width="32" Height="32" Margin="0,0,10,0" Visibility="{DynamicResource AppIconVisibility}"/><Ellipse DockPanel.Dock="Left" Width="10" Height="10" Fill="{Binding SignalColor}" Margin="0,0,10,0"/><StackPanel VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding NewBadge}" Foreground="{DynamicResource Blue}" FontWeight="Bold" FontSize="10" Margin="0,0,6,0"/><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock x:Name="BlockAttemptsLink" Visibility="{DynamicResource CleanDetailVisibility}" Cursor="Hand" TextDecorations="Underline" Text="{Binding BlockSummary}" FontSize="11" Foreground="{DynamicResource Warning}" ToolTip="Blockierte Ziele und Sperrgründe öffnen" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding DirectionSummary}" Foreground="{DynamicResource Muted}" FontSize="10" TextTrimming="CharacterEllipsis" ToolTip="{Binding DirectionSummary}"/><TextBlock Text="{Binding ReviewReason}" Foreground="{Binding ReviewColor}" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding ReviewReason}"/><TextBlock Text="{Binding FileChangeLabel}" Visibility="{Binding FileChangeVisibility}" Foreground="{DynamicResource Warning}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="Dateiinhalt unterscheidet sich von der Vergleichsbasis; in den Details ansehen."/></StackPanel></DockPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Aktueller Zugriff" Binding="{Binding Status}" Width="155"/><DataGridTextColumn Header="Zuletzt aktiv" Binding="{Binding LastSeen}" Width="135"/><DataGridTextColumn Header="Prüfung" Binding="{Binding Review}" Width="120"/><DataGridTextColumn Header="Gesendet" Binding="{Binding Sent}" Width="90"/><DataGridTextColumn Header="Empfangen" Binding="{Binding Received}" Width="90"/><DataGridTextColumn Header="Aktivität" Binding="{Binding FutureActivity}" Width="135" Visibility="Collapsed"/></DataGrid.Columns></DataGrid>
 <StackPanel Grid.Row="4"><WrapPanel x:Name="ReviewListActions" Visibility="Collapsed" Margin="0,6"><Button x:Name="OverviewReviewDetails" Content="Prüfdetails ansehen" Background="{DynamicResource AccentSoft}"/><Button x:Name="OverviewReviewDone" Content="Auswahl geprüft"/><Button x:Name="AcknowledgeNew" Content="Liste geprüft …"/></WrapPanel><TextBlock x:Name="ProgramListEmpty" Text="" Foreground="{DynamicResource Muted}" Margin="0,8"/><WrapPanel x:Name="OverviewQuickActions" Margin="0,0,0,8"><Button x:Name="OverviewQuickBlock" Content="Sperren …" Background="{DynamicResource DangerSoft}" ToolTip="Ausgewähltes Programm: alle Ziele/Protokolle, beide Richtungen; neue externe Verbindungen"/><Button x:Name="OverviewQuickTempBlock" Content="Zeitweise sperren …" Background="{DynamicResource WarningSoft}"/><Button x:Name="OverviewQuickEndTemporary" Content="Zeitweise beenden …" Visibility="Collapsed"/><Button x:Name="OverviewQuickAllow" Content="Erlauben …" Background="{DynamicResource SuccessSoft}"/><Button x:Name="OverviewQuickTemporary" Content="10 Minuten erlauben …"/><Button x:Name="OverviewQuickReview" Content="Als geprüft markieren"/></WrapPanel><DockPanel x:Name="OverviewFooter"><WrapPanel x:Name="OverviewFooterButtons" DockPanel.Dock="Right"><Button x:Name="OverviewGroup" Content="Gruppe …" Padding="8,5"/><Button x:Name="OverviewFavorite" Content="☆ Als Favorit merken"/><Button x:Name="OverviewGuide" Content="Prüfassistent →" Padding="8,5"/><Button x:Name="OverviewShowPrograms" Content="Details öffnen" Background="{DynamicResource AccentSoft}"/><Button x:Name="OverviewPermissions" Content="Zugriff ändern"/><Button x:Name="ResetNetzblick" Content="Alles neu prüfen …"/></WrapPanel><StackPanel><TextBlock x:Name="LastNetworkChange" MaxWidth="250" TextTrimming="CharacterEllipsis" Text="Noch keine aufgezeichnete Änderung." Foreground="{DynamicResource Muted}" FontSize="11"/><Button x:Name="UndoNetwork" Content="Letzte Änderung rückgängig" IsEnabled="False" HorizontalAlignment="Left"/></StackPanel></DockPanel></StackPanel>
</Grid>
