<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Wiederherstellung prüfen" Width="850" Height="650" MinWidth="700" MinHeight="520" WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBg}" Foreground="{DynamicResource Text}" FontFamily="Segoe UI"><Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock x:Name="RestoreTitle" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="RestoreEffect" TextWrapping="Wrap" Foreground="{DynamicResource Warning}" Margin="0,12"/><TextBlock x:Name="RestoreCounts" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,10"/></StackPanel><DataGrid x:Name="RestoreEntries" Grid.Row="1"><DataGrid.Columns><DataGridTextColumn Header="Eintrag" Binding="{Binding Name}" Width="220"/><DataGridTemplateColumn Header="Wird aus der Sicherung übernommen" Width="*" MinWidth="350"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Detail}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid><StackPanel Grid.Row="2" Margin="0,12,0,0"><TextBlock x:Name="RestoreProblem" TextWrapping="Wrap" Foreground="{DynamicResource Danger}"/><TextBlock Text="Vor der Übernahme wird der bisherige eigene Zustand automatisch gesichert. Die Liste ersetzt ausschließlich die ausgewählte Kategorie; nicht aufgeführte bisherige Einträge dieser Kategorie entfallen." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="11"/><WrapPanel HorizontalAlignment="Right" Margin="0,10,0,0"><Button Content="Abbrechen" IsCancel="True"/><Button x:Name="RestoreApply" Content="Nur diese Kategorie wiederherstellen" Background="{DynamicResource AccentSoft}"/></WrapPanel></StackPanel></Grid></Window>
