<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid.RowDefinitions><RowDefinition Height="45"/><RowDefinition Height="34"/><RowDefinition Height="*"/><RowDefinition Height="170"/><RowDefinition Height="36"/></Grid.RowDefinitions>
 <DockPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button x:Name="BackFromTerminal" Content="← Programme"/><Button x:Name="RunProbe" Content="▶ Ausführen" Background="#087F8C"/><Button x:Name="StopProbe" Content="■ Stoppen" IsEnabled="False"/><Button x:Name="ClearProbe" Content="Leeren"/></StackPanel><TextBox x:Name="CommandInput" Text="ping example.org" FontFamily="Consolas" FontSize="16" VerticalContentAlignment="Center" Margin="0,3,12,3" ToolTip="ping [-4|-6] Ziel oder tracert [-4|-6] Ziel · Enter zum Starten"/></DockPanel>
 <TextBlock Grid.Row="1" x:Name="ProbeSummary" Text="ping example.org · tracert example.org · traceroute -6 example.org · 10 Pings / maximal 30 Hops" Foreground="#57677B" TextWrapping="Wrap"/>
 <Grid Grid.Row="2" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <TextBox x:Name="TerminalOutput" IsReadOnly="True" Background="#08111C" Foreground="#69DAC3" FontFamily="Consolas" FontSize="13" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="14" Margin="0,0,12,0" Text="NETZBLICK · NETZWERKDIAGNOSE&#10;Befehl eingeben und mit Enter starten.&#10;Dies ist ein Terminal für Ping und Traceroute, keine allgemeine Shell.&#10;"/>
  <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="140"/></Grid.RowDefinitions>
   <Border Background="#0A1B2C" CornerRadius="8" Padding="4" Margin="0,0,0,10"><Viewbox Stretch="Uniform"><Canvas x:Name="RouteMap" Width="1000" Height="500" ClipToBounds="True"><Canvas x:Name="RouteOverlay" Width="1000" Height="500"/></Canvas></Viewbox></Border>
   <DataGrid Grid.Row="1" x:Name="ProbeRows" SelectionMode="Single"><DataGrid.Columns><DataGridTextColumn Header="Nr." Binding="{Binding Number}" Width="40"/><DataGridTextColumn Header="IP-Adresse" Binding="{Binding Address}" Width="*"/><DataGridTextColumn Header="Antwortzeit" Binding="{Binding Latency}" Width="85"/><DataGridTextColumn Header="Land" Binding="{Binding Code}" Width="55"/></DataGrid.Columns></DataGrid>
  </Grid>
 </Grid>
 <Border Grid.Row="3" Background="#FFFFFF" CornerRadius="8" Padding="10"><DockPanel><TextBlock DockPanel.Dock="Top" x:Name="LatencyTitle" Text="ANTWORTZEITEN · keine Messung" Foreground="#57677B" FontSize="12" Margin="0,0,0,6"/><Viewbox Stretch="Fill"><Canvas x:Name="LatencyChart" Width="1000" Height="130"/></Viewbox></DockPanel></Border>
 <TextBlock Grid.Row="4" Text="Kartenpunkte: geschätzte Länder (DB-IP / Natural Earth). Zeitlimit ≠ Ziel ausgefallen. Traceroute zeigt ICMP-Antworten; fehlende Hops und Rückwege können abweichen." Foreground="#57677B" FontSize="11" TextWrapping="Wrap"/>
</Grid>

