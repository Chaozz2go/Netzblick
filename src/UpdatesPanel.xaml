<ScrollViewer xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" VerticalScrollBarVisibility="Auto">
 <StackPanel MaxWidth="850" HorizontalAlignment="Left">
  <TextBlock Text="Netzblick aktuell halten" FontSize="26" FontWeight="SemiBold"/>
  <TextBlock x:Name="InstalledVersion" Margin="0,10"/>
  <TextBlock Text="Updates werden nur auf deinen Klick bei Chaozz2go/Netzblick geprüft. Die App funktioniert weiterhin offline. Ein Update installiert sich nicht ungefragt." TextWrapping="Wrap" Foreground="#57677B"/>
  <StackPanel Orientation="Horizontal" Margin="0,15,0,8"><Button x:Name="CheckUpdates" Content="Auf Updates prüfen" Background="#DDF0F2"/><Button x:Name="OpenReleases" Content="Downloadseite öffnen"/></StackPanel>
  <CheckBox x:Name="IncludePrereleases" Content="Testversionen einschließen" Margin="0,8"/>
  <CheckBox x:Name="IncludeDrafts" Content="Release-Entwürfe einschließen (Zugriff auf Entwürfe erforderlich)" Margin="0,8"/>
  <Border Background="White" CornerRadius="8" Padding="18" Margin="0,12"><StackPanel><TextBlock x:Name="UpdateMessage" Text="Noch nicht geprüft." TextWrapping="Wrap" FontSize="16"/><TextBlock x:Name="ReleaseKind" Foreground="#9C650A" Margin="0,8"/><Button x:Name="OpenUpdate" Content="Version auf GitHub ansehen und herunterladen" HorizontalAlignment="Left" IsEnabled="False"/><TextBox x:Name="UpdateNotes" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="220" VerticalScrollBarVisibility="Auto" BorderThickness="0" Margin="0,8"/></StackPanel></Border>
  <Expander Header="GitHub-Zugang für das private Repository" Margin="0,12"><StackPanel Margin="0,12">
   <TextBlock Text="Ein Fine-grained Personal Access Token benötigt Zugriff nur auf Netzblick mit Contents: Read. Der Zugang wird mit Windows für dein Benutzerkonto verschlüsselt gespeichert. Er wird bei der portablen Version nicht mitkopiert. Ein Token mit Schreibrechten ist nicht nötig; die Sichtbarkeit von Entwürfen hängt zusätzlich von deinem GitHub-Zugriff ab." TextWrapping="Wrap" Foreground="#57677B"/>
   <TextBlock x:Name="TokenStatus" Margin="0,10"/><PasswordBox x:Name="GitHubToken" MaxLength="512" Padding="8"/>
   <StackPanel Orientation="Horizontal" Margin="0,8"><Button x:Name="SaveGitHubToken" Content="Zugang speichern"/><Button x:Name="ForgetGitHubToken" Content="Zugang entfernen"/></StackPanel>
  </StackPanel></Expander>
 </StackPanel>
</ScrollViewer>
