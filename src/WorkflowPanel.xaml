<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=mscorlib">
 <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <StackPanel Margin="0,0,0,12"><TextBlock x:Name="WorkflowTitle" Text="Offene Programme bewerten" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Beobachtungen verstehen, gezielt entscheiden und wichtige Programme griffbereit behalten." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
 <TabControl Template="{DynamicResource ContentOnlyTabs}" x:Name="WorkflowViews" Grid.Row="1"><TabItem Header="Prüfassistent"><Grid Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,10"><Button x:Name="StartGuide" Content="Durchgang starten / neu laden" DockPanel.Dock="Right"/><TextBlock x:Name="GuideProgress" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"/></DockPanel>
  <Border Grid.Row="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" Padding="16" Margin="0,0,0,12"><StackPanel><TextBlock x:Name="GuideName" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="GuidePath" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,6"/><TextBlock x:Name="GuideReason" Foreground="{DynamicResource Warning}" FontSize="16" TextWrapping="Wrap"/><TextBlock x:Name="GuideStatus" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border>
  <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock x:Name="GuideSnapshotHint" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,8"/><DataGrid x:Name="GuideEvidence" Grid.Row="1" SelectionMode="Single" RowHeight="{x:Static sys:Double.NaN}" MinRowHeight="48"><DataGrid.Columns><DataGridTextColumn Header="Was ist neu?" Binding="{Binding Kind}" Width="145"/><DataGridTextColumn Header="Beobachtetes Ziel" Binding="{Binding Target}" Width="210"/><DataGridTemplateColumn Header="Einordnung / Sperrgrund" Width="*" MinWidth="230"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Margin="6"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></Grid>
  <WrapPanel Grid.Row="3" Margin="0,12,0,0"><Button x:Name="GuideBack" Content="← Zurück"/><Button x:Name="GuideNext" Content="Später / Weiter →"/><Button x:Name="GuideDone" Content="Angezeigten Stand geprüft &amp; weiter" Background="{DynamicResource AccentSoft}"/><Button x:Name="GuideTempBlock" Content="Zeitweise sperren …" Background="{DynamicResource WarningSoft}"/><Button x:Name="GuideRules" Content="Regeln ansehen"/><Button x:Name="GuideDetails" Content="Programmdetails"/><Button x:Name="GuideReload" Content="Beobachtungen aktualisieren"/></WrapPanel>
 </Grid></TabItem>
 <TabItem Header="Favoriten"><Grid Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Margin="0,0,0,10"><TextBlock Text="Deine wichtigen Programme" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="In der Programmliste oder den Details mit ☆ merken. Ampel und Restzeit werden aus dem aktuellen Dienststatus gelesen." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,6,0,0"/><TextBlock x:Name="FavoritesEmpty" Text="Noch keine Favoriten. Programme lassen sich auch ohne aktuellen Netzwerkzugriff merken." TextWrapping="Wrap" Foreground="{DynamicResource Warning}" Margin="0,8,0,0"/></StackPanel>
  <DataGrid x:Name="FavoritesList" Grid.Row="1" SelectionMode="Single" RowHeight="82"><DataGrid.Columns><DataGridTemplateColumn Header="Programm" Width="*" MinWidth="260"><DataGridTemplateColumn.CellTemplate><DataTemplate><DockPanel Margin="6"><Image Source="{Binding Icon}" Width="30" Height="30" DockPanel.Dock="Left" Margin="0,0,10,0"/><Ellipse Width="10" Height="10" Fill="{Binding SignalColor}" DockPanel.Dock="Left" Margin="0,0,10,0"/><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="{Binding Status}" Foreground="{DynamicResource Muted}" Margin="0,3,0,0"/><TextBlock Text="{Binding Activity}" Foreground="{DynamicResource Muted}" FontSize="10" TextTrimming="CharacterEllipsis"/></StackPanel></DockPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Zeitweise Entscheidung / Restzeit" Binding="{Binding LeaseText}" Width="290"/></DataGrid.Columns></DataGrid>
  <StackPanel Grid.Row="2" Margin="0,12,0,0"><TextBlock x:Name="FavoritePath" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/><WrapPanel Margin="0,6,0,0"><Button x:Name="FavoriteBlock" Content="Zeitweise vom Netz trennen …" Background="{DynamicResource WarningSoft}"/><Button x:Name="FavoriteResume" Content="Zeitweise Entscheidung beenden …"/><Button x:Name="FavoriteDetails" Content="Programmdetails →"/><Button x:Name="FavoriteRemove" Content="Favorit entfernen"/></WrapPanel></StackPanel>
 </Grid></TabItem></TabControl>
</Grid>
