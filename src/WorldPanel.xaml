<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="38"/><RowDefinition Height="*"/><RowDefinition Height="185"/><RowDefinition Height="45"/></Grid.RowDefinitions>
 <DockPanel Margin="0,0,0,8"><StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><TextBlock Text="Programm" Margin="0,0,10,0"/><ComboBox x:Name="WorldPrograms" Width="250" DisplayMemberPath="Name" Foreground="#102030" Background="#19283C" Padding="8"/><TextBlock Text="Ausgangsland (manuell)" Margin="20,0,10,0"/><ComboBox x:Name="OriginCountry" Width="205" DisplayMemberPath="Display" Foreground="#102030" Background="#19283C" Padding="8"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="BackFromWorld" Content="← Programme"/><Button x:Name="WorldShowProgram" Content="Zum Programm" IsEnabled="False"/><Button x:Name="WorldTrace" Content="Im Terminal öffnen" IsEnabled="False"/></StackPanel></DockPanel>
 <TextBlock Grid.Row="1" x:Name="WorldSummary" Text="Karte wird vorbereitet …" Foreground="#57677B" TextWrapping="Wrap"/>
 <Border Grid.Row="2" Background="#0A1B2C" BorderBrush="#27405B" BorderThickness="1" CornerRadius="8" Margin="0,0,0,12" Padding="4"><Viewbox Stretch="Uniform"><Canvas x:Name="WorldMap" Width="1000" Height="500" ClipToBounds="True"><Canvas x:Name="WorldOverlay" Width="1000" Height="500"/></Canvas></Viewbox></Border>
 <DataGrid Grid.Row="3" x:Name="WorldPeers" SelectionMode="Single"><DataGrid.Columns><DataGridTextColumn Header="Programm" Binding="{Binding Program}" Width="160"/><DataGridTextColumn Header="Gegenstelle" Binding="{Binding Address}" Width="*"/><DataGridTextColumn Header="Land / Zuordnung" Binding="{Binding Country}" Width="230"/><DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="65"/><DataGridTextColumn Header="Sockets" Binding="{Binding Count}" Width="75"/><DataGridTextColumn Header="Genauigkeit" Binding="{Binding Kind}" Width="300"/></DataGrid.Columns></DataGrid>
 <TextBlock Grid.Row="4" Text="Länderpunkte sind schematisch, keine Serverkoordinaten oder Leitungswege. Blau: beobachtete TCP-Gegenstellen · Grün: manuelles Ausgangsland. IP Geolocation by DB-IP (db-ip.com), CC BY 4.0 · Karte: Natural Earth." Foreground="#57677B" FontSize="11" TextWrapping="Wrap"/>
</Grid>

